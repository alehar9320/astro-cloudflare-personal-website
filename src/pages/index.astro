---
import CallToAction from '../components/CallToAction.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const linkedinHref = 'https://www.linkedin.com/in/alehar/';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://me.alehar.workers.dev/#person',
      name: 'Alexander Härenstam',
      jobTitle: 'Product Manager, Developer Experience at IFS',
      description: 'Product Manager, Developer Experience at IFS. Get in touch on LinkedIn.',
      url: 'https://me.alehar.workers.dev/',
      sameAs: [
        'https://www.linkedin.com/in/alehar/',
        'https://github.com/alehar9320',
        'https://blog.ifs.com/author/alexander-harenstam/',
      ],
      worksFor: {
        '@type': 'Organization',
        name: 'IFS',
        url: 'https://www.ifs.com/',
      },
      knowsAbout: [
        'Developer Experience (DevEx)',
        'Design Systems',
        'Industrial AI',
        'Product Management',
      ],
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Chalmers University of Technology',
        url: 'https://www.chalmers.se/en/',
      },
      award: 'Zeroheight Design System Awards - Runner-up',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://me.alehar.workers.dev/#website',
      url: 'https://me.alehar.workers.dev/',
      name: 'Alexander Härenstam | Product Manager, Developer Experience at IFS',
      publisher: { '@id': 'https://me.alehar.workers.dev/#person' },
      description: 'Product Manager, Developer Experience at IFS. Get in touch on LinkedIn.',
    },
    {
      '@type': 'WebPage',
      '@id': 'https://me.alehar.workers.dev/#webpage',
      url: 'https://me.alehar.workers.dev/',
      name: 'Alexander Härenstam | Product Manager, Developer Experience at IFS',
      about: { '@id': 'https://me.alehar.workers.dev/#person' },
      description: 'Product Manager, Developer Experience at IFS. Get in touch on LinkedIn.',
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: 'https://me.alehar.workers.dev/assets/portrait.png',
      },
    },
  ],
};
---

<BaseLayout
  title="Alexander Härenstam | Product Manager, Developer Experience at IFS"
  description="Product Manager, Developer Experience at IFS. Get in touch on LinkedIn."
  ogTitle="Product Manager, Developer Experience at IFS"
  showAurora={true}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <main id="main-content" class="wrapper stack first-screen">
    <header class="hero">
      <div class="hero-copy">
        <Hero title="Product Manager, Developer Experience at IFS" align="start">
          <p class="hero-dek">Design systems, developer platforms, and Industrial AI copilots.</p>
          <div class="hero-actions">
            <CallToAction
              href={linkedinHref}
              target="_blank"
              rel="noopener noreferrer"
              data-hire-event="hire_cta_click"
              data-hire-surface="hero"
            >
              Get in touch
            </CallToAction>
            <p class="cta-hint">LinkedIn</p>
          </div>
        </Hero>
        <section class="proof" aria-label="Proof">
          <a class="proof-card" href="/work/ifs-design-system/">
            <p class="proof-eyebrow">IFS Design System</p>
            <p class="proof-outcome">Took the design system from first version to IFS Cloud.</p>
            <p class="proof-chips">
              <span>Up to 2x faster delivery</span>
              <span aria-hidden="true">·</span>
              <span>Up to 30x ROI</span>
              <span aria-hidden="true">·</span>
              <span>Zeroheight Design System Awards, runner-up</span>
            </p>
            <p class="proof-affordance">Read the case</p>
          </a>
        </section>
        <p class="hero-bridge">
          Chalmers software engineering. Eight years at IFS. Design system, copilots, and analytics.
        </p>
      </div>
    </header>
  </main>
</BaseLayout>

<style>
  .first-screen {
    min-height: 100vh;
    min-height: 100svh;
    min-height: 100dvh;
    justify-content: flex-start;
    gap: 1rem;
    padding-block: 1rem var(--chat-fab-clearance);
    box-sizing: border-box;
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 0;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 100%;
  }

  .hero-dek {
    margin: 0;
    max-width: 42ch;
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--gray-200);
    line-height: 1.45;
  }

  .hero-bridge {
    margin: 0;
    max-width: 42ch;
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--gray-300);
    line-height: 1.45;
  }

  .hero-actions {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
    justify-content: center;
  }

  .cta-hint {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--gray-300);
    font-weight: 400;
  }

  .proof-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding: 0;
    text-decoration: none;
    color: inherit;
    background: none;
    border: 0;
    box-shadow: none;
  }

  .proof-card:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  .proof-card:hover .proof-affordance,
  .proof-card:focus-visible .proof-affordance {
    color: var(--gray-0);
  }

  .proof-eyebrow {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--gray-200);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .proof-outcome {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 650;
    color: var(--gray-0);
    letter-spacing: -0.01em;
  }

  .proof-chips {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    font-size: var(--text-sm);
    color: var(--gray-200);
  }

  .proof-affordance {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--gray-300);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 44px;
    box-sizing: border-box;
    transition: color var(--theme-transition);
  }

  @media (min-width: 50em) {
    .first-screen {
      justify-content: center;
    }

    .hero {
      padding-inline: 2.5rem;
      gap: 0.85rem;
      padding-bottom: 0;
    }

    .hero-copy {
      gap: 0.5rem;
    }

    .hero-actions {
      margin-top: 0.25rem;
      justify-content: flex-start;
      align-items: flex-start;
    }

    .hero-dek {
      max-width: 48ch;
    }

    .proof-card {
      gap: 0.25rem;
    }

    /* Hero.astro stack gap-4 is 1rem — tighten on home so proof clears dock */
    .hero-copy :global(.stack.gap-4) {
      gap: 0.5rem;
    }
  }

  /* ~800px-tall desktop: 44×44 Read the case clears dock ≥16 (#812 restack) */
  @media (min-width: 50em) and (max-height: 52em) {
    :global(body.has-prominent-chat) .first-screen {
      padding-top: 0;
      gap: 0.25rem;
    }

    .hero {
      gap: 0.4rem;
    }

    .hero-copy {
      gap: 0.2rem;
    }

    .hero-actions {
      margin-top: 0;
      gap: 0.15rem;
    }

    .hero-copy :global(.stack.gap-4) {
      gap: 0.2rem;
    }

    .hero-copy :global(.stack.gap-2) {
      gap: 0.15rem;
    }

    /* Home-only: step H1 down so proof hit-box clears dock (Hero stays 5xl elsewhere) */
    .hero-copy :global(.title) {
      font-size: var(--text-4xl);
      line-height: 1.12;
    }

    .proof-card {
      gap: 0.15rem;
    }

    .proof-outcome {
      font-size: var(--text-lg);
    }
  }

  :global(body.has-prominent-chat) .first-screen {
    padding-bottom: 36dvh;
    justify-content: flex-start;
  }

  @media (max-width: 49.99em) {
    :global(body.has-prominent-chat) .first-screen {
      padding-bottom: 0;
      gap: 0.75rem;
    }
    :global(body.has-prominent-chat) .hero-copy {
      gap: 0.75rem;
    }
  }
</style>