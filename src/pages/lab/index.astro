---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';

const labExperiments = [
  {
    title: 'Aurora Light Refraction',
    slug: 'aurora-refraction',
    description:
      'Multi-harmonic sine wave synthesis & interactive optical light refraction ribbons.',
    tags: ['Canvas 2D', 'Math & Physics', 'Northern Lights', '60fps'],
    icon: 'rocket-launch' as const,
  },
];
---

<BaseLayout
  title="Digital Art Laboratory | Alexander Härenstam"
  description="Experimental interactive canvas, WebGL, and generative digital art lab."
>
  <main class="wrapper stack gap-8" style="margin-block: 3rem 5rem;">
    <Hero
      title="Digital Art Laboratory"
      tagline="Experimental interactive visual art, fluid light dynamics, and generative canvas physics."
      align="start"
    />

    <section class="lab-grid" aria-label="Laboratory Experiments">
      {
        labExperiments.map((exp) => (
          <article class="lab-card">
            <div class="card-header">
              <Icon icon={exp.icon} size="2rem" color="var(--accent-regular)" gradient />
              <h2>{exp.title}</h2>
            </div>
            <p class="description">{exp.description}</p>
            <div class="tag-row">
              {exp.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <a href={`/lab/${exp.slug}/`} class="launch-link">
              Launch Experiment <span aria-hidden="true">&rarr;</span>
            </a>
          </article>
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  .lab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .lab-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    border-radius: 1rem;
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--theme-transition),
      border-color var(--theme-transition);
  }

  .lab-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent-regular);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .card-header h2 {
    font-size: var(--text-lg);
    color: var(--gray-0);
    margin: 0;
  }

  .description {
    color: var(--gray-300);
    font-size: var(--text-sm);
    line-height: 1.5;
    margin: 0;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: var(--text-xs);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--gray-800_40);
    color: var(--gray-200);
    border: 1px solid var(--gray-700);
  }

  .launch-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-light);
    text-decoration: none;
    min-height: 44px;
  }

  .launch-link:hover,
  .launch-link:focus-visible {
    text-decoration: underline;
    color: var(--gray-0);
  }

  .launch-link:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }
</style>
