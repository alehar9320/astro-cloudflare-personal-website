---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Interactive Canvas Lab | Alexander Härenstam"
  description="Laboratory directory of experimental digital art, interactive canvases, and creative visual experiments."
  robots="noindex"
>
  <main id="main-content" class="wrapper stack gap-8">
    <header class="lab-header stack gap-2">
      <h1 class="title">Interactive Canvas Laboratory</h1>
      <p class="dek">
        A isolated sandbox for creative web technology, mathematical animations, and fluid canvas
        micro-interactions.
      </p>
    </header>

    <section class="lab-grid" aria-label="Laboratory Experiments">
      <article class="lab-card">
        <div class="card-body stack gap-3">
          <div class="card-badge">HTML5 Canvas</div>
          <h2 class="card-title">Northern Lights Light Refraction</h2>
          <p class="card-description">
            Real-time parametric sine wave ribbons with pointer-driven light refractions rendered in
            marine blue and cyan gradients.
          </p>
          <a href="/lab/aurora-refraction/" class="card-link">
            Launch Experiment <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .lab-header {
    margin-top: 2rem;
  }

  .title {
    font-size: var(--text-3xl);
    color: var(--gray-0);
  }

  .dek {
    max-width: 52ch;
    font-size: var(--text-md);
    color: var(--gray-300);
    line-height: 1.5;
  }

  .lab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .lab-card {
    border-radius: 1rem;
    padding: 1.5rem;
    background: hsla(var(--gray-999-basis), 0.5);
    border: 1px solid var(--gray-800);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      border-color var(--theme-transition),
      transform var(--theme-transition);
  }

  .lab-card:hover {
    border-color: var(--accent-regular);
  }

  .card-badge {
    align-self: flex-start;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent-light);
    background: hsla(var(--accent-regular-basis), 0.15);
    padding: 0.2rem 0.6rem;
    border-radius: 999rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .card-title {
    font-size: var(--text-xl);
    color: var(--gray-0);
    margin: 0;
  }

  .card-description {
    font-size: var(--text-sm);
    color: var(--gray-300);
    line-height: 1.5;
    margin: 0;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-regular);
    text-decoration: none;
    margin-top: 0.5rem;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  .card-link:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }
</style>
