---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Northern Lights Refraction Lab | Alexander Härenstam"
  description="Interactive HTML5 canvas light refraction and wave dynamics experiment powered by native TypeScript math."
  robots="noindex, nofollow"
>
  <main id="main-content" class="wrapper stack gap-8">
    <header class="lab-header">
      <div class="eyebrow">Lab / Experiment 01</div>
      <h1 class="title">Northern Lights Refraction</h1>
      <p class="description">
        Real-time multi-harmonic wave refraction and fluid light interaction generated with pure
        TypeScript vector math and HTML5 Canvas.
      </p>
    </header>

    <section class="lab-viewport" aria-label="Interactive Canvas Experiment">
      <div class="canvas-container">
        <canvas id="prism-canvas" class="prism-canvas"></canvas>
        <div class="canvas-overlay">
          <div class="controls-toolbar" role="toolbar" aria-label="Canvas animation controls">
            <button
              id="pause-toggle"
              type="button"
              class="control-btn"
              aria-label="Pause or play refraction animation"
              aria-pressed="false"
            >
              <span id="pause-icon" aria-hidden="true">⏸</span>
              <span id="pause-text">Pause</span>
            </button>
            <button
              id="reset-pointer"
              type="button"
              class="control-btn"
              aria-label="Reset refraction distortion point"
            >
              <span aria-hidden="true">↺</span> Reset Wave
            </button>
          </div>
          <p class="interaction-hint">
            <span aria-hidden="true">✨</span> Move cursor or touch canvas to refract light fields
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import { calculateRefractionWave, interpolateNorthernLightsColor } from '../../utils/prism-math';

  const canvas = document.getElementById('prism-canvas') as HTMLCanvasElement | null;
  const pauseBtn = document.getElementById('pause-toggle') as HTMLButtonElement | null;
  const pauseIcon = document.getElementById('pause-icon') as HTMLSpanElement | null;
  const pauseText = document.getElementById('pause-text') as HTMLSpanElement | null;
  const resetBtn = document.getElementById('reset-pointer') as HTMLButtonElement | null;

  if (canvas) {
    const ctx = canvas.getContext('2d');
    let animationFrameId: number;
    let isPlaying = true;
    let time = 0;
    let pointer: { x: number; y: number } | null = null;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      isPlaying = false;
      if (pauseBtn && pauseIcon && pauseText) {
        pauseBtn.setAttribute('aria-pressed', 'true');
        pauseIcon.textContent = '▶';
        pauseText.textContent = 'Play';
      }
    }

    const resize = () => {
      if (!canvas || !canvas.parentElement) return;
      const rect = canvas.parentElement.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(rect.width * dpr);
      canvas.height = Math.floor(rect.height * dpr);
      if (ctx) {
        ctx.scale(dpr, dpr);
      }
    };

    const render = () => {
      if (!ctx || !canvas) return;
      const width = canvas.parentElement?.clientWidth || 600;
      const height = canvas.parentElement?.clientHeight || 400;

      ctx.clearRect(0, 0, width, height);

      // Adaptive step size based on viewport width for 60fps performance
      const step = width < 600 ? 12 : 8;
      const cols = Math.ceil(width / step);
      const rows = Math.ceil(height / step);

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const x = c * step;
          const y = r * step;

          const waveVal = calculateRefractionWave(x, y, time, pointer);
          const normalized = (waveVal + 1) / 2; // [0, 1]
          const color = interpolateNorthernLightsColor(normalized);

          ctx.fillStyle = `rgba(${color.r}, ${color.g}, ${color.b}, ${0.15 + normalized * 0.45})`;
          ctx.fillRect(x, y, step, step);
        }
      }

      if (isPlaying) {
        time += 0.025;
        animationFrameId = requestAnimationFrame(render);
      }
    };

    const onPointerMove = (e: PointerEvent) => {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      pointer = {
        x: e.clientX - rect.left,
        y: e.clientY - rect.top,
      };
      if (!isPlaying) {
        render();
      }
    };

    const onPointerLeave = () => {
      pointer = null;
      if (!isPlaying) {
        render();
      }
    };

    const togglePlayPause = () => {
      isPlaying = !isPlaying;
      if (pauseBtn && pauseIcon && pauseText) {
        pauseBtn.setAttribute('aria-pressed', String(!isPlaying));
        pauseIcon.textContent = isPlaying ? '⏸' : '▶';
        pauseText.textContent = isPlaying ? 'Pause' : 'Play';
      }
      if (isPlaying) {
        render();
      } else {
        cancelAnimationFrame(animationFrameId);
      }
    };

    const resetPointerDistortion = () => {
      pointer = null;
      if (!isPlaying) {
        render();
      }
    };

    const onVisibilityChange = () => {
      if (document.hidden) {
        cancelAnimationFrame(animationFrameId);
      } else if (isPlaying) {
        render();
      }
    };

    window.addEventListener('resize', resize);
    canvas.addEventListener('pointermove', onPointerMove);
    canvas.addEventListener('pointerleave', onPointerLeave);
    document.addEventListener('visibilitychange', onVisibilityChange);

    if (pauseBtn) {
      pauseBtn.addEventListener('click', togglePlayPause);
    }
    if (resetBtn) {
      resetBtn.addEventListener('click', resetPointerDistortion);
    }

    resize();
    render();

    // Clean up when navigating away during Astro page transitions
    document.addEventListener(
      'astro:before-swap',
      () => {
        isPlaying = false;
        cancelAnimationFrame(animationFrameId);
        window.removeEventListener('resize', resize);
        if (canvas) {
          canvas.removeEventListener('pointermove', onPointerMove);
          canvas.removeEventListener('pointerleave', onPointerLeave);
        }
        document.removeEventListener('visibilitychange', onVisibilityChange);
      },
      { once: true }
    );
  }
</script>

<style>
  .lab-header {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .eyebrow {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-light);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .title {
    font-size: var(--text-3xl);
    color: var(--gray-0);
    margin: 0;
  }

  .description {
    font-size: var(--text-md);
    color: var(--gray-200);
    max-width: 54ch;
    margin: 0;
    line-height: 1.5;
  }

  .lab-viewport {
    width: 100%;
    margin-bottom: 3rem;
  }

  .canvas-container {
    position: relative;
    width: 100%;
    height: 440px;
    border-radius: 1rem;
    overflow: hidden;
    background: radial-gradient(circle at 50% 50%, #001f35 0%, #000c18 100%);
    border: 1px solid hsla(var(--gray-999-basis), 0.2);
    box-shadow: 0 12px 32px rgba(0, 43, 73, 0.4);
  }

  .prism-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: crosshair;
    touch-action: none;
  }

  .canvas-overlay {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .controls-toolbar {
    display: flex;
    gap: 0.5rem;
    pointer-events: auto;
  }

  .control-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--gray-0);
    background: hsla(var(--gray-999-basis), 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid hsla(var(--gray-0-basis), 0.15);
    cursor: pointer;
    transition: all var(--theme-transition);
  }

  .control-btn:hover,
  .control-btn:focus-visible {
    background: hsla(var(--gray-999-basis), 0.85);
    border-color: var(--accent-light);
    outline: none;
    box-shadow: 0 0 12px var(--accent-light);
  }

  .interaction-hint {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--gray-300);
    background: hsla(var(--gray-999-basis), 0.4);
    padding: 0.35rem 0.75rem;
    border-radius: 999rem;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  @media (max-width: 40em) {
    .canvas-container {
      height: 360px;
    }

    .canvas-overlay {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
