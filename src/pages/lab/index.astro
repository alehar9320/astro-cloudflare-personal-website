---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Interactive Canvas Lab | Alexander Härenstam"
  description="Interactive Northern Lights fluid wave refraction canvas laboratory built with pure TypeScript algorithms and HTML5 Canvas."
>
  <main id="main-content" class="wrapper lab-container">
    <header class="lab-header">
      <h1 class="lab-title">Interactive Canvas Laboratory</h1>
      <p class="lab-description">
        An experimental interactive Northern Lights fluid wave simulation built with pure TypeScript
        wave synthesis math, dynamic spatial sampling, and cursor refraction vectors.
      </p>
    </header>

    <section class="lab-controls" aria-label="Canvas animation controls">
      <div class="control-group">
        <button
          id="lab-play-btn"
          type="button"
          class="control-btn"
          aria-label="Pause or resume canvas animation"
        >
          Pause
        </button>
        <button
          id="lab-speed-btn"
          type="button"
          class="control-btn"
          aria-label="Cycle wave animation speed"
        >
          Speed: 1.0x
        </button>

        <button
          id="lab-theme-btn"
          type="button"
          class="control-btn"
          aria-label="Cycle Northern Lights color theme"
        >
          Theme: Aurora Cyan
        </button>
      </div>
      <p class="lab-hint">Move cursor or drag touch across canvas to refract light vectors.</p>
    </section>

    <section class="canvas-wrapper">
      <p class="sr-only">
        An interactive canvas showing smooth synthesized waves in marine blue and cyan gradients
        with interactive light refraction.
      </p>
      <canvas
        id="aurora-lab-canvas"
        aria-label="Interactive Northern Lights wave simulation canvas"
        role="img"></canvas>
    </section>
  </main>
</BaseLayout>

<script>
  import {
    calculateRefractionOffset,
    calculateWaveY,
    getSpatialStep,
    type WaveParams,
  } from '../../utils/aurora-math';

  const canvas = document.getElementById('aurora-lab-canvas') as HTMLCanvasElement | null;
  const playBtn = document.getElementById('lab-play-btn') as HTMLButtonElement | null;
  const speedBtn = document.getElementById('lab-speed-btn') as HTMLButtonElement | null;
  const themeBtn = document.getElementById('lab-theme-btn') as HTMLButtonElement | null;

  if (canvas && canvas.dataset.initialized !== 'true') {
    canvas.dataset.initialized = 'true';
    const ctx = canvas.getContext('2d');

    let animationFrameId: number | null = null;
    let isPlaying = true;
    let time = 0;
    let speedMultiplier = 1.0;
    let themeIndex = 0;

    let mouseX: number | null = null;
    let mouseY: number | null = null;

    const themes = [
      { name: 'Aurora Cyan', colors: ['#00f2fe', '#4facfe', '#00ffcc'] },
      { name: 'Northern Violet', colors: ['#7000ff', '#a100ff', '#00f2fe'] },
      { name: 'Emerald Glow', colors: ['#00ffaa', '#00f2fe', '#00b8ff'] },
    ];

    const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const resize = () => {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      if (ctx) {
        ctx.scale(dpr, dpr);
      }
    };

    const waveLayers: WaveParams[] = [
      { frequency: 0.008, amplitude: 35, speed: 0.02, phaseShift: 0, verticalOffset: 0.35 },
      {
        frequency: 0.012,
        amplitude: 25,
        speed: 0.028,
        phaseShift: Math.PI / 3,
        verticalOffset: 0.5,
      },
      {
        frequency: 0.006,
        amplitude: 45,
        speed: 0.015,
        phaseShift: Math.PI / 1.5,
        verticalOffset: 0.65,
      },
    ];

    const draw = () => {
      if (!ctx || !canvas) return;

      const rect = canvas.getBoundingClientRect();
      const w = rect.width;
      const h = rect.height;

      ctx.clearRect(0, 0, w, h);

      // Deep marine night background layer
      const bgGrad = ctx.createLinearGradient(0, 0, 0, h);
      bgGrad.addColorStop(0, '#0d1b2a');
      bgGrad.addColorStop(1, '#020813');
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, w, h);

      const spatialStep = getSpatialStep(w);
      const activeTheme = themes[themeIndex];

      waveLayers.forEach((layer, idx) => {
        const strokeColor = activeTheme.colors[idx % activeTheme.colors.length];
        const vOffsetPx = h * layer.verticalOffset;

        ctx.beginPath();
        let firstPoint = true;

        for (let x = 0; x <= w + spatialStep; x += spatialStep) {
          const rawY = calculateWaveY(x, time, {
            ...layer,
            verticalOffset: vOffsetPx,
          });

          const refraction = calculateRefractionOffset(mouseX, mouseY, x, rawY, 160, 30);
          const finalX = x + refraction.dx;
          const finalY = rawY + refraction.dy;

          if (firstPoint) {
            ctx.moveTo(finalX, finalY);
            firstPoint = false;
          } else {
            ctx.lineTo(finalX, finalY);
          }
        }

        // Draw ambient aura glow line
        ctx.strokeStyle = strokeColor;
        ctx.lineWidth = 3 - idx * 0.5;
        ctx.shadowColor = strokeColor;
        ctx.shadowBlur = 12;
        ctx.stroke();
      });

      if (isPlaying && !isReducedMotion) {
        time += 0.03 * speedMultiplier;
        animationFrameId = requestAnimationFrame(draw);
      }
    };

    const handleMouseMove = (e: MouseEvent) => {
      const rect = canvas.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
      if (!isPlaying || isReducedMotion) {
        draw();
      }
    };

    const handleMouseLeave = () => {
      mouseX = null;
      mouseY = null;
      if (!isPlaying || isReducedMotion) {
        draw();
      }
    };

    const handleTouchMove = (e: TouchEvent) => {
      if (e.touches.length > 0) {
        const rect = canvas.getBoundingClientRect();
        mouseX = e.touches[0].clientX - rect.left;
        mouseY = e.touches[0].clientY - rect.top;
        if (!isPlaying || isReducedMotion) {
          draw();
        }
      }
    };

    const handleVisibilityChange = () => {
      if (document.hidden) {
        if (animationFrameId) cancelAnimationFrame(animationFrameId);
      } else if (isPlaying && !isReducedMotion) {
        draw();
      }
    };

    // Button controls
    playBtn?.addEventListener('click', () => {
      isPlaying = !isPlaying;
      if (playBtn) playBtn.textContent = isPlaying ? 'Pause' : 'Play';
      if (isPlaying && !isReducedMotion) {
        draw();
      } else if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
      }
    });

    speedBtn?.addEventListener('click', () => {
      if (speedMultiplier === 1.0) speedMultiplier = 1.5;
      else if (speedMultiplier === 1.5) speedMultiplier = 0.5;
      else speedMultiplier = 1.0;

      if (speedBtn) speedBtn.textContent = `Speed: ${speedMultiplier.toFixed(1)}x`;
    });

    themeBtn?.addEventListener('click', () => {
      themeIndex = (themeIndex + 1) % themes.length;
      if (themeBtn) themeBtn.textContent = `Theme: ${themes[themeIndex].name}`;
      draw();
    });

    window.addEventListener('resize', resize);
    canvas.addEventListener('mousemove', handleMouseMove);
    canvas.addEventListener('mouseleave', handleMouseLeave);
    canvas.addEventListener('touchmove', handleTouchMove, { passive: true });
    canvas.addEventListener('touchend', handleMouseLeave);
    document.addEventListener('visibilitychange', handleVisibilityChange);

    document.addEventListener(
      'astro:before-swap',
      () => {
        if (canvas) canvas.dataset.initialized = 'false';
        if (animationFrameId) cancelAnimationFrame(animationFrameId);
        window.removeEventListener('resize', resize);
        document.removeEventListener('visibilitychange', handleVisibilityChange);
      },
      { once: true }
    );

    resize();
    draw();
  }
</script>

<style>
  .lab-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 2rem 4rem;
  }

  .lab-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lab-title {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--gray-0);
  }

  .lab-description {
    font-size: var(--text-md);
    color: var(--gray-200);
    max-width: 65ch;
    line-height: 1.5;
  }

  .lab-controls {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: rgba(13, 27, 42, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
  }

  .control-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .control-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 1.25rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--gray-0);
    background: var(--accent-subtle-overlay, rgba(255, 255, 255, 0.08));
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.5rem;
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .control-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: var(--accent-regular, #00f2fe);
  }

  .control-btn:focus-visible {
    outline: 2px solid var(--accent-regular, #00f2fe);
    outline-offset: 2px;
  }

  .lab-hint {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--gray-300);
  }

  .canvas-wrapper {
    position: relative;
    width: 100%;
    height: 420px;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
