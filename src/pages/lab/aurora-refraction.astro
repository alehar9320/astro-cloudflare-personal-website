---
import Hero from '../../components/Hero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Aurora Refraction Lab | Digital Art"
  description="Interactive Northern Lights refraction canvas with math-driven sine wave superposition and interactive mouse refraction vector fields."
>
  <main id="main-content" class="wrapper stack gap-8">
    <Hero
      title="Aurora Refraction Matrix"
      tagline="Interactive Northern Lights refraction canvas using multi-layer wave superposition and vector field displacement."
      align="center"
    />

    <section class="lab-container" aria-label="Interactive Canvas">
      <div class="canvas-wrapper">
        <canvas
          id="aurora-refraction-canvas"
          aria-label="Interactive Northern Lights refraction visual canvas"
          role="img"></canvas>
        <div class="canvas-controls">
          <button id="toggle-animation" class="control-btn" type="button" aria-live="polite">
            Pause Motion
          </button>
          <span id="canvas-status" class="status-label">60fps · Interactive Vector Field</span>
        </div>
      </div>

      <div class="lab-description">
        <h2>Mathematical Visual Dynamics</h2>
        <p>
          This creative canvas superimposes four discrete mathematical wave layers using harmonic
          sine functions. Moving your cursor or touch input across the surface generates an elastic
          refraction vector field with quadratic spatial falloff, refracting light across the
          Northern Lights color spectrum.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import {
    calculateRefractionVector,
    calculateWaveHeight,
    colorToRgbaString,
    interpolateAuroraColor,
    type WaveLayer,
  } from '../../utils/aurora-math';

  const canvas = document.getElementById('aurora-refraction-canvas') as HTMLCanvasElement | null;
  const toggleBtn = document.getElementById('toggle-animation') as HTMLButtonElement | null;
  const statusLabel = document.getElementById('canvas-status') as HTMLElement | null;

  if (canvas) {
    const ctx = canvas.getContext('2d');
    let animationFrameId: number | null = null;
    let isPlaying = true;
    let time = 0;

    let mouseX = -1000;
    let mouseY = -1000;

    const layers: WaveLayer[] = [
      { amplitude: 24, frequency: 0.008, speed: 0.02, phase: 0 },
      { amplitude: 16, frequency: 0.015, speed: -0.015, phase: Math.PI / 3 },
      { amplitude: 12, frequency: 0.022, speed: 0.025, phase: Math.PI / 1.5 },
      { amplitude: 8, frequency: 0.035, speed: -0.03, phase: Math.PI },
    ];

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const resize = () => {
      if (!canvas || !canvas.parentElement) return;
      const rect = canvas.parentElement.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;

      if (ctx) {
        ctx.scale(dpr, dpr);
      }
    };

    const draw = () => {
      if (!ctx || !canvas || !canvas.parentElement) return;

      const width = canvas.parentElement.clientWidth;
      const height = canvas.parentElement.clientHeight;

      ctx.clearRect(0, 0, width, height);

      // Render dark marine canvas base
      const baseGradient = ctx.createLinearGradient(0, 0, 0, height);
      baseGradient.addColorStop(0, 'rgba(2, 26, 46, 0.9)');
      baseGradient.addColorStop(1, 'rgba(0, 15, 30, 0.95)');
      ctx.fillStyle = baseGradient;
      ctx.fillRect(0, 0, width, height);

      const numRibbons = 12;
      const stepX = Math.max(8, Math.floor(width / 60));

      for (let r = 0; r < numRibbons; r++) {
        const ribbonRatio = r / numRibbons;
        const color = interpolateAuroraColor(ribbonRatio);
        const baseY = height * (0.2 + ribbonRatio * 0.6);

        ctx.beginPath();
        let firstPoint = true;

        for (let x = 0; x <= width + stepX; x += stepX) {
          const waveY = calculateWaveHeight(x, time, layers);
          const py = baseY + waveY;

          // Compute interactive refraction vector displacement
          const refraction = calculateRefractionVector(mouseX, mouseY, x, py, 140);
          const drawX = x + refraction.dx;
          const drawY = py + refraction.dy;

          if (firstPoint) {
            ctx.moveTo(drawX, drawY);
            firstPoint = false;
          } else {
            ctx.lineTo(drawX, drawY);
          }
        }

        ctx.strokeStyle = colorToRgbaString(color);
        ctx.lineWidth = 2 + (1 - ribbonRatio) * 3;
        ctx.stroke();
      }

      if (isPlaying && !prefersReducedMotion) {
        time += 0.03;
        animationFrameId = requestAnimationFrame(draw);
      }
    };

    const onPointerMove = (e: MouseEvent | TouchEvent) => {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;

      mouseX = clientX - rect.left;
      mouseY = clientY - rect.top;

      if (!isPlaying && !prefersReducedMotion) {
        draw();
      }
    };

    const onPointerLeave = () => {
      mouseX = -1000;
      mouseY = -1000;
      if (!isPlaying && !prefersReducedMotion) {
        draw();
      }
    };

    const togglePlayPause = () => {
      isPlaying = !isPlaying;
      if (toggleBtn) {
        toggleBtn.textContent = isPlaying ? 'Pause Motion' : 'Play Motion';
      }
      if (statusLabel) {
        statusLabel.textContent = isPlaying
          ? '60fps · Interactive Vector Field'
          : 'Paused · Interactive Refraction Active';
      }
      if (isPlaying) {
        draw();
      } else if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
    };

    if (prefersReducedMotion) {
      isPlaying = false;
      if (toggleBtn) {
        toggleBtn.textContent = 'Static (Reduced Motion)';
        toggleBtn.disabled = true;
      }
      if (statusLabel) {
        statusLabel.textContent = 'Static mode (prefers-reduced-motion)';
      }
    }

    // Attach event listeners
    window.addEventListener('resize', resize);
    canvas.addEventListener('mousemove', onPointerMove);
    canvas.addEventListener('mouseleave', onPointerLeave);
    canvas.addEventListener('touchmove', onPointerMove, { passive: true });
    canvas.addEventListener('touchend', onPointerLeave);

    if (toggleBtn) {
      toggleBtn.addEventListener('click', togglePlayPause);
    }

    const onVisibilityChange = () => {
      if (document.hidden && animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      } else if (!document.hidden && isPlaying && !prefersReducedMotion) {
        draw();
      }
    };

    document.addEventListener('visibilitychange', onVisibilityChange);

    // Initial setup
    resize();
    draw();

    // Clean up when navigating away (Astro page transitions / before-swap)
    document.addEventListener(
      'astro:before-swap',
      () => {
        isPlaying = false;
        if (animationFrameId) {
          cancelAnimationFrame(animationFrameId);
        }
        window.removeEventListener('resize', resize);
        document.removeEventListener('visibilitychange', onVisibilityChange);
        if (canvas) {
          canvas.removeEventListener('mousemove', onPointerMove);
          canvas.removeEventListener('mouseleave', onPointerLeave);
          canvas.removeEventListener('touchmove', onPointerMove);
          canvas.removeEventListener('touchend', onPointerLeave);
        }
        if (toggleBtn) {
          toggleBtn.removeEventListener('click', togglePlayPause);
        }
      },
      { once: true }
    );
  }
</script>

<style>
  .lab-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 50rem;
    margin-inline: auto;
    width: 100%;
  }

  .canvas-wrapper {
    position: relative;
    width: 100%;
    height: 380px;
    border-radius: 1rem;
    overflow: hidden;
    background: hsla(var(--gray-999-basis), 0.5);
    border: 1px solid hsla(var(--gray-999-basis), 0.2);
    box-shadow: var(--shadow-md);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  @media (min-width: 50em) {
    .canvas-wrapper {
      height: 480px;
    }
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: crosshair;
  }

  .canvas-controls {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 1rem;
    background: hsla(var(--gray-999-basis), 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 0.5rem;
    border: 1px solid hsla(0, 0%, 100%, 0.1);
  }

  .control-btn {
    background: hsla(200, 80%, 20%, 0.8);
    color: var(--gray-0);
    border: 1px solid var(--accent-regular);
    padding: 0.35rem 0.85rem;
    border-radius: 0.375rem;
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s ease;
    min-height: 44px;
  }

  .control-btn:hover:not(:disabled) {
    background: var(--accent-regular);
  }

  .control-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .status-label {
    font-size: var(--text-xs);
    color: var(--gray-300);
    font-family: monospace;
  }

  .lab-description {
    padding: 1.5rem;
    border-radius: 0.75rem;
    background: hsla(var(--gray-999-basis), 0.4);
    border: 1px solid hsla(var(--gray-999-basis), 0.15);
  }

  .lab-description h2 {
    font-size: var(--text-md);
    color: var(--gray-0);
    margin-bottom: 0.5rem;
  }

  .lab-description p {
    font-size: var(--text-sm);
    color: var(--gray-200);
    line-height: 1.6;
    margin: 0;
  }
</style>
