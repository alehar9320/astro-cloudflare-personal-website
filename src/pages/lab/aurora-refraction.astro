---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
---

<BaseLayout
  title="Aurora Light Refraction Canvas | Creative Laboratory"
  description="Interactive Northern Lights wave refraction simulation written in pure TypeScript and HTML5 Canvas."
  robots="noindex"
>
  <main id="main-content" class="wrapper stack gap-8">
    <Hero
      title="Aurora Light Refraction"
      tagline="Interactive spatial wave refraction canvas with real-time math simulation."
      align="start"
    />

    <section class="lab-card" aria-label="Aurora Canvas Simulation">
      <div class="canvas-header">
        <h2 class="lab-title">Northern Lights Field</h2>
        <div class="controls-group">
          <button id="toggle-anim-btn" type="button" class="control-btn" aria-pressed="false">
            Pause Simulation
          </button>
          <span class="keyboard-hint" aria-hidden="true">[Space] Toggle</span>
        </div>
      </div>

      <div class="canvas-container">
        <canvas
          id="aurora-refraction-canvas"
          aria-label="Interactive Northern Lights refraction canvas"></canvas>
      </div>

      <p class="lab-description">
        Superimposed sine wave refractions using dynamic spatial step sampling. Responsive to
        viewport sizing and accessibility preferences.
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  import {
    calculateAuroraWavePoint,
    getSpatialStep,
    getAuroraColor,
    type WaveParameters,
  } from '../../utils/aurora-waves';

  function initAuroraCanvas() {
    const canvas = document.getElementById('aurora-refraction-canvas') as HTMLCanvasElement | null;
    const toggleBtn = document.getElementById('toggle-anim-btn') as HTMLButtonElement | null;
    if (!canvas || canvas.dataset.initialized === 'true') return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    canvas.dataset.initialized = 'true';

    let animationFrameId: number | null = null;
    let isPaused = false;
    let time = 0;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      isPaused = true;
      if (toggleBtn) {
        toggleBtn.textContent = 'Play Simulation';
        toggleBtn.setAttribute('aria-pressed', 'true');
      }
    }

    const waves: WaveParameters[] = [
      { wavelength: 120, amplitude: 25, speed: 0.02, offset: 0 },
      { wavelength: 240, amplitude: 35, speed: 0.015, offset: Math.PI / 3 },
      { wavelength: 180, amplitude: 20, speed: 0.025, offset: Math.PI / 1.5 },
    ];

    const resize = () => {
      const container = canvas.parentElement;
      if (!container) return;
      const rect = container.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);
    };

    const render = () => {
      if (!ctx || !canvas) return;

      const container = canvas.parentElement;
      const w = container ? container.clientWidth : 800;
      const h = container ? container.clientHeight : 400;

      ctx.clearRect(0, 0, w, h);

      // Canvas background gradient
      const bgGrad = ctx.createLinearGradient(0, 0, 0, h);
      bgGrad.addColorStop(0, 'rgba(15, 23, 42, 0.95)');
      bgGrad.addColorStop(1, 'rgba(6, 78, 99, 0.6)');
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, w, h);

      const step = getSpatialStep(w);
      const layers = 3;

      for (let layer = 0; layer < layers; layer++) {
        const baseY = h * (0.4 + layer * 0.15);
        const colorRatio = (layer + 1) / layers;
        const color = getAuroraColor(colorRatio, 0.35 - layer * 0.08);

        ctx.beginPath();
        ctx.moveTo(0, h);

        for (let x = 0; x <= w; x += step) {
          const y = calculateAuroraWavePoint(x, time + layer * 15, baseY, waves);
          if (x === 0) {
            ctx.lineTo(x, y);
          } else {
            ctx.lineTo(x, y);
          }
        }

        ctx.lineTo(w, h);
        ctx.closePath();
        ctx.fillStyle = color;
        ctx.fill();
      }

      if (!isPaused) {
        time += 1;
        animationFrameId = requestAnimationFrame(render);
      }
    };

    const toggleAnimation = () => {
      isPaused = !isPaused;
      if (toggleBtn) {
        toggleBtn.textContent = isPaused ? 'Play Simulation' : 'Pause Simulation';
        toggleBtn.setAttribute('aria-pressed', isPaused ? 'true' : 'false');
      }
      if (!isPaused) {
        animationFrameId = requestAnimationFrame(render);
      } else if (animationFrameId !== null) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
    };

    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.code === 'Space' && document.activeElement !== toggleBtn) {
        e.preventDefault();
        toggleAnimation();
      }
    };

    const handleVisibilityChange = () => {
      if (document.hidden && animationFrameId !== null) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      } else if (!document.hidden && !isPaused && animationFrameId === null) {
        animationFrameId = requestAnimationFrame(render);
      }
    };

    if (toggleBtn) {
      toggleBtn.addEventListener('click', toggleAnimation);
    }
    window.addEventListener('resize', resize);
    window.addEventListener('keydown', handleKeyDown);
    document.addEventListener('visibilitychange', handleVisibilityChange);

    resize();
    render();

    const cleanup = () => {
      if (animationFrameId !== null) {
        cancelAnimationFrame(animationFrameId);
      }
      if (toggleBtn) {
        toggleBtn.removeEventListener('click', toggleAnimation);
      }
      window.removeEventListener('resize', resize);
      window.removeEventListener('keydown', handleKeyDown);
      document.removeEventListener('visibilitychange', handleVisibilityChange);
      if (canvas) {
        canvas.dataset.initialized = 'false';
      }
    };

    document.addEventListener('astro:before-swap', cleanup, { once: true });
  }

  document.addEventListener('astro:page-load', initAuroraCanvas);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initAuroraCanvas();
  }
</script>

<style>
  .lab-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem;
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow-sm);
  }

  .canvas-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .lab-title {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--gray-100);
  }

  .controls-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .control-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 1rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--gray-100);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--gray-700);
    border-radius: 0.5rem;
    cursor: pointer;
    transition:
      background-color var(--theme-transition),
      border-color var(--theme-transition);
  }

  .control-btn:hover,
  .control-btn:focus-visible {
    background: rgba(255, 255, 255, 0.16);
    border-color: var(--accent-regular);
    outline: none;
  }

  .keyboard-hint {
    font-size: var(--text-xs);
    color: var(--gray-400);
  }

  .canvas-container {
    width: 100%;
    height: 380px;
    position: relative;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid var(--gray-800);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .lab-description {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--gray-300);
    line-height: 1.5;
  }
</style>
