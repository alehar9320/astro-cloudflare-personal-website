---
import AuroraCanvas from '../../components/AuroraCanvas.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Aurora Lab | Alexander Härenstam"
  description="Laboratory experimental interactive canvas demonstrating fluid Northern Lights light refraction."
>
  <main id="main-content" class="wrapper lab-container">
    <div class="lab-card">
      <h1>Northern Lights Canvas Lab</h1>
      <p>
        Interactive fluid light refraction experiment powered by HTML5 Canvas, cubic smoothstep
        attenuation, and sinusoidal vector math. Move your pointer across the viewport to observe
        the refraction field.
      </p>
    </div>
    <div class="canvas-preview">
      <AuroraCanvas />
    </div>
  </main>
</BaseLayout>

<style>
  .lab-container {
    padding-block: 4rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;
  }

  .lab-card {
    max-width: 48ch;
    padding: 2rem;
    border-radius: 1rem;
    background: hsla(var(--gray-999-basis), 0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid hsla(var(--gray-0-basis), 0.1);
    text-align: center;
  }

  .lab-card h1 {
    font-size: var(--text-2xl);
    color: var(--gray-0);
    margin-bottom: 0.5rem;
  }

  .lab-card p {
    font-size: var(--text-md);
    color: var(--gray-200);
    line-height: 1.5;
  }

  .canvas-preview {
    position: relative;
    width: 100%;
    height: 400px;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid hsla(var(--gray-0-basis), 0.1);
    background: var(--gray-999);
  }
</style>
