---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuroraCanvas from '../../components/AuroraCanvas.astro';
import Hero from '../../components/Hero.astro';
---

<BaseLayout title="Aurora Lab" description="Laboratory for Prism interactive components.">
  <main class="wrapper stack gap-20" style="margin-top: 4rem;">
    <section class="lab-hero">
      <AuroraCanvas />
      <Hero
        title="Prism Aurora Lab"
        tagline="Testing the high-performance generative aurora background."
        align="center"
      />
    </section>

    <section class="controls">
      <h2>Performance & Visual Check</h2>
      <p>This page verifies the Aurora Canvas component in isolation.</p>
      <ul>
        <li>60fps animation loop</li>
        <li>Automatic DPR scaling</li>
        <li>Respects prefers-reduced-motion</li>
        <li>Zero global CSS leakage</li>
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .lab-hero {
    position: relative;
    padding: 10rem 2rem;
    border: 1px dashed var(--gray-800);
    border-radius: 1.5rem;
    overflow: hidden;
  }

  .controls {
    padding: 2rem;
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
  }

  h2 {
    color: var(--gray-0);
    margin-bottom: 1rem;
  }

  ul {
    color: var(--gray-300);
    line-height: 1.6;
  }
</style>
