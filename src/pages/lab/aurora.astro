---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Aurora Canvas Lab | Interactive Digital Art"
  description="Interactive Northern Lights canvas lab with real-time vector light refractions and mathematical wave motion."
>
  <main id="main-content" class="wrapper stack gap-8">
    <header class="lab-header">
      <div class="lab-badge">Interactive Laboratory</div>
      <h1 class="lab-title">Northern Lights Aurora Canvas</h1>
      <p class="lab-subtitle">
        A mathematical canvas simulation rendering multi-harmonic wave ribbons with interactive vector light refractions in marine blue and cyan.
      </p>
    </header>

    <section class="canvas-card" aria-label="Interactive Aurora Canvas Laboratory">
      <div class="controls-bar" role="toolbar" aria-label="Canvas interactive controls">
        <button
          id="toggle-anim"
          type="button"
          class="control-btn"
          aria-pressed="false"
          aria-label="Pause animation"
        >
          <span class="btn-icon" aria-hidden="true">⏸</span>
          <span class="btn-label">Pause</span>
        </button>

        <button
          id="toggle-refraction"
          type="button"
          class="control-btn"
          aria-pressed="true"
          aria-label="Toggle light refraction effect"
        >
          <span class="btn-icon" aria-hidden="true">✨</span>
          <span class="btn-label">Refraction: On</span>
        </button>

        <div id="canvas-status" class="status-indicator" role="status" aria-live="polite">
          60 FPS · 4 Wave Layers
        </div>
      </div>

      <div class="canvas-container" id="canvas-wrapper">
        <canvas id="aurora-canvas" role="img" aria-label="Interactive Northern Lights wave visualization"></canvas>
        <div id="pointer-hint" class="pointer-hint">
          <span>Move cursor or tap to refract light</span>
        </div>
      </div>

      <div class="shortcuts-note">
        <p><strong>Keyboard Controls:</strong> <kbd>Space</kbd> Pause/Play · <kbd>R</kbd> Reset pointer focus</p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import {
    calculateAuroraWaveHeight,
    calculateRefractionOffset,
    getAdaptiveCanvasQuality,
    interpolateAuroraColor,
    type Point2D,
  } from '../../utils/aurora-math';

  function initAuroraLab() {
    const canvas = document.getElementById('aurora-canvas') as HTMLCanvasElement | null;
    const container = document.getElementById('canvas-wrapper');
    const toggleAnimBtn = document.getElementById('toggle-anim') as HTMLButtonElement | null;
    const toggleRefractionBtn = document.getElementById('toggle-refraction') as HTMLButtonElement | null;
    const statusEl = document.getElementById('canvas-status');
    const pointerHint = document.getElementById('pointer-hint');

    if (!canvas || !container) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let animFrameId: number = 0;
    let isRunning = true;
    let refractionEnabled = true;
    let time = 0;

    // Motion accessibility check
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      isRunning = false;
      if (toggleAnimBtn) {
        toggleAnimBtn.setAttribute('aria-pressed', 'true');
        toggleAnimBtn.querySelector('.btn-label')!.textContent = 'Play';
        toggleAnimBtn.querySelector('.btn-icon')!.textContent = '▶';
      }
    }

    let pointer: Point2D | null = null;
    let targetPointer: Point2D | null = null;

    // Performance tracking
    let lastFrameTime = performance.now();
    let frameCount = 0;
    const fpsHistory: number[] = [];
    let currentFps = 60;

    const resize = () => {
      if (!canvas || !container) return;
      const width = container.clientWidth || 800;
      const height = 450;
      const quality = getAdaptiveCanvasQuality(width, currentFps, window.devicePixelRatio || 1);

      canvas.width = Math.floor(width * quality.pixelRatio);
      canvas.height = Math.floor(height * quality.pixelRatio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      ctx.scale(quality.pixelRatio, quality.pixelRatio);
    };

    const handlePointerMove = (e: MouseEvent | TouchEvent) => {
      if (pointerHint) {
        pointerHint.style.opacity = '0';
      }
      const rect = canvas.getBoundingClientRect();
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;

      targetPointer = {
        x: clientX - rect.left,
        y: clientY - rect.top,
      };
    };

    const handlePointerLeave = () => {
      targetPointer = null;
    };

    const render = (now: number) => {
      const delta = now - lastFrameTime;
      lastFrameTime = now;

      if (delta > 0) {
        const instantFps = 1000 / delta;
        fpsHistory.push(instantFps);
        if (fpsHistory.length > 30) fpsHistory.shift();
        frameCount++;

        if (frameCount % 30 === 0) {
          const avgFps = Math.round(fpsHistory.reduce((a, b) => a + b, 0) / fpsHistory.length);
          currentFps = avgFps;
          if (statusEl) {
            const width = container.clientWidth || 800;
            const quality = getAdaptiveCanvasQuality(width, currentFps, window.devicePixelRatio || 1);
            statusEl.textContent = `${currentFps} FPS · ${quality.layerCount} Wave Layers`;
          }
        }
      }

      const width = container.clientWidth || 800;
      const height = 450;
      const quality = getAdaptiveCanvasQuality(width, currentFps, window.devicePixelRatio || 1);

      if (isRunning) {
        time += 0.015;
      }

      // Smooth pointer interpolation
      if (targetPointer) {
        if (!pointer) pointer = { ...targetPointer };
        pointer.x += (targetPointer.x - pointer.x) * 0.15;
        pointer.y += (targetPointer.y - pointer.y) * 0.15;
      } else {
        pointer = null;
      }

      ctx.clearRect(0, 0, width, height);

      // Deep space background gradient
      const bgGrad = ctx.createLinearGradient(0, 0, 0, height);
      bgGrad.addColorStop(0, '#040d1a');
      bgGrad.addColorStop(1, '#08172e');
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, width, height);

      // Render Aurora Wave Layers
      const layers = quality.layerCount;
      const baseHeights = [height * 0.35, height * 0.45, height * 0.55, height * 0.65];
      const stepSize = quality.stepSize;

      for (let l = 0; l < layers; l++) {
        const centerY = baseHeights[l] || height * 0.5;
        const waveParams = {
          frequency: 0.003 + l * 0.001,
          amplitude: 35 + l * 10,
          speed: 1.0 + l * 0.2,
          phase: l * 1.5,
          harmonics: l % 2 === 0 ? 3 : 2,
        };

        ctx.beginPath();
        ctx.moveTo(0, height);

        for (let x = 0; x <= width; x += stepSize) {
          const waveDisplacement = calculateAuroraWaveHeight(x, time, waveParams);
          let wy = centerY + waveDisplacement;
          let wx = x;

          if (refractionEnabled && pointer) {
            const refraction = calculateRefractionOffset(pointer, { x: wx, y: wy }, 180, 25);
            wx += refraction.dx;
            wy += refraction.dy;
          }

          if (x === 0) {
            ctx.lineTo(wx, wy);
          } else {
            ctx.lineTo(wx, wy);
          }
        }

        ctx.lineTo(width, height);
        ctx.closePath();

        const layerFactor = l / Math.max(1, layers - 1);
        const auroraColor = interpolateAuroraColor(layerFactor, 0.35 + l * 0.12);

        ctx.fillStyle = auroraColor;
        ctx.shadowColor = auroraColor;
        ctx.shadowBlur = 12;
        ctx.fill();
        ctx.shadowBlur = 0;
      }

      if (isRunning || targetPointer) {
        animFrameId = requestAnimationFrame(render);
      }
    };

    // Controls setup
    if (toggleAnimBtn) {
      toggleAnimBtn.addEventListener('click', () => {
        isRunning = !isRunning;
        toggleAnimBtn.setAttribute('aria-pressed', isRunning ? 'false' : 'true');
        const label = toggleAnimBtn.querySelector('.btn-label');
        const icon = toggleAnimBtn.querySelector('.btn-icon');
        if (label) label.textContent = isRunning ? 'Pause' : 'Play';
        if (icon) icon.textContent = isRunning ? '⏸' : '▶';

        if (isRunning) {
          lastFrameTime = performance.now();
          animFrameId = requestAnimationFrame(render);
        }
      });
    }

    if (toggleRefractionBtn) {
      toggleRefractionBtn.addEventListener('click', () => {
        refractionEnabled = !refractionEnabled;
        toggleRefractionBtn.setAttribute('aria-pressed', refractionEnabled ? 'true' : 'false');
        const label = toggleRefractionBtn.querySelector('.btn-label');
        if (label) label.textContent = `Refraction: ${refractionEnabled ? 'On' : 'Off'}`;
      });
    }

    // Keyboard navigation
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;

      if (e.code === 'Space') {
        e.preventDefault();
        if (toggleAnimBtn) toggleAnimBtn.click();
      } else if (e.code === 'KeyR') {
        e.preventDefault();
        targetPointer = null;
        pointer = null;
      }
    };

    window.addEventListener('resize', resize);
    window.addEventListener('keydown', handleKeyDown);
    container.addEventListener('mousemove', handlePointerMove as EventListener);
    container.addEventListener('mouseleave', handlePointerLeave);
    container.addEventListener('touchstart', handlePointerMove as EventListener, { passive: true });
    container.addEventListener('touchend', handlePointerLeave);

    resize();
    render(performance.now());

    // Astro page transition cleanup
    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelAnimationFrame(animFrameId);
        window.removeEventListener('resize', resize);
        window.removeEventListener('keydown', handleKeyDown);
        container.removeEventListener('mousemove', handlePointerMove as EventListener);
        container.removeEventListener('mouseleave', handlePointerLeave);
        container.removeEventListener('touchstart', handlePointerMove as EventListener);
        container.removeEventListener('touchend', handlePointerLeave);
      },
      { once: true },
    );
  }

  // Initialize on load and Astro page navigation
  initAuroraLab();
  document.addEventListener('astro:page-load', initAuroraLab);
</script>

<style>
  .lab-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .lab-badge {
    align-self: flex-start;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(0, 210, 230, 0.12);
    color: var(--accent-light, #00d2e6);
    border: 1px solid rgba(0, 210, 230, 0.25);
  }

  .lab-title {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--gray-0);
    margin: 0;
  }

  .lab-subtitle {
    font-size: var(--text-md);
    color: var(--gray-200);
    margin: 0;
    max-width: 65ch;
    line-height: 1.5;
  }

  .canvas-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    background: rgba(12, 24, 44, 0.65);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
  }

  .controls-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .control-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    min-height: 38px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    color: var(--gray-0);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .control-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .control-btn:focus-visible {
    outline: 2px solid var(--accent-regular, #00d2e6);
    outline-offset: 2px;
  }

  .status-indicator {
    margin-left: auto;
    font-size: var(--text-xs);
    color: var(--gray-300);
    font-family: monospace;
    background: rgba(0, 0, 0, 0.3);
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
  }

  .canvas-container {
    position: relative;
    width: 100%;
    height: 450px;
    background: #040d1a;
    border-radius: 8px;
    overflow: hidden;
    cursor: crosshair;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .pointer-hint {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.4rem 0.8rem;
    background: rgba(4, 13, 26, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(0, 210, 230, 0.3);
    border-radius: 20px;
    color: var(--gray-200);
    font-size: var(--text-xs);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .shortcuts-note {
    font-size: var(--text-xs);
    color: var(--gray-300);
    margin-top: -0.25rem;
  }

  kbd {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    font-size: 0.85em;
  }

  @media (max-width: 640px) {
    .controls-bar {
      flex-direction: column;
      align-items: stretch;
    }

    .status-indicator {
      margin-left: 0;
      text-align: center;
    }

    .canvas-container {
      height: 320px;
    }
  }
</style>
