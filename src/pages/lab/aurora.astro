---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Northern Lights Laboratory | Digital Art Canvas"
  description="Interactive Northern Lights canvas lab featuring fluid refractions, light particles, and custom sine wave superposition."
>
  <main class="wrapper lab-container">
    <header class="lab-header">
      <h1>Northern Lights Canvas Lab</h1>
      <p class="lab-description">
        A math-driven interactive refraction canvas using pure TypeScript wave superposition and particle physics.
      </p>
      <div class="lab-controls-hint">
        <span class="badge">Keyboard: Space to Pause / Play</span>
        <span class="badge">Pointer: Move to refract lights</span>
      </div>
    </header>

    <div class="canvas-wrapper">
      <canvas id="aurora-lab-canvas" aria-label="Interactive Northern Lights canvas animation"></canvas>
      <div class="canvas-overlay">
        <button id="toggle-motion-btn" type="button" class="motion-toggle" aria-label="Toggle animation state">
          Pause Motion
        </button>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import { superimposeWaves, updateParticle, type WaveConfig, type ParticleState } from '../../utils/aurora-math';

  const canvas = document.getElementById('aurora-lab-canvas') as HTMLCanvasElement | null;
  const toggleBtn = document.getElementById('toggle-motion-btn') as HTMLButtonElement | null;

  if (canvas && canvas.getContext) {
    const ctx = canvas.getContext('2d');
    let animationFrameId: number = 0;
    let isPaused = false;
    let time = 0;

    // Check prefers-reduced-motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      isPaused = true;
      if (toggleBtn) toggleBtn.textContent = 'Play Motion';
    }

    // Cursor interaction state
    let pointer = { x: -1000, y: -1000, active: false };

    // Waves definition
    const waves: WaveConfig[] = [
      { wavelength: 320, amplitude: 45, speed: 0.015, phase: 0 },
      { wavelength: 180, amplitude: 25, speed: 0.025, phase: 1.2 },
      { wavelength: 100, amplitude: 12, speed: 0.035, phase: 2.5 },
    ];

    // Particles definition
    let particles: ParticleState[] = [];

    const initParticles = (width: number, height: number) => {
      // Scale down particle count on small screens for 60fps performance budget
      const count = width < 600 ? 15 : 35;
      particles = [];
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.6,
          vy: (Math.random() - 0.5) * 0.4,
          alpha: 0.2 + Math.random() * 0.5,
        });
      }
    };

    const resize = () => {
      if (!canvas) return;
      const rect = canvas.parentElement?.getBoundingClientRect();
      const width = rect?.width || 800;
      const height = rect?.height || 450;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = width * dpr;
      canvas.height = height * dpr;

      if (ctx) {
        ctx.scale(dpr, dpr);
      }

      initParticles(width, height);
    };

    const render = () => {
      if (!ctx || !canvas) return;

      const width = canvas.width / (Math.min(window.devicePixelRatio || 1, 2));
      const height = canvas.height / (Math.min(window.devicePixelRatio || 1, 2));

      ctx.clearRect(0, 0, width, height);

      // Deep dark marine backdrop
      const bgGrad = ctx.createLinearGradient(0, 0, 0, height);
      bgGrad.addColorStop(0, '#050b14');
      bgGrad.addColorStop(1, '#0a192f');
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, width, height);

      if (!isPaused) {
        time += 1;
      }

      // Draw aurora wave ribbons
      const wavePoints: { x: number; y: number }[] = [];
      const baseHeight = height * 0.55;

      ctx.beginPath();
      ctx.moveTo(0, height);

      for (let x = 0; x <= width; x += 10) {
        let waveY = baseHeight + superimposeWaves(x, time, waves);

        // Pointer refraction effect
        if (pointer.active) {
          const dx = x - pointer.x;
          const dist = Math.abs(dx);
          if (dist < 150) {
            const factor = Math.cos((dist / 150) * (Math.PI / 2));
            waveY += factor * 35 * Math.sin(time * 0.05);
          }
        }

        wavePoints.push({ x, y: waveY });
        ctx.lineTo(x, waveY);
      }

      ctx.lineTo(width, height);
      ctx.closePath();

      // Northern Lights gradient fill
      const auroraGrad = ctx.createLinearGradient(0, baseHeight - 60, 0, height);
      auroraGrad.addColorStop(0, 'rgba(0, 255, 213, 0.45)');
      auroraGrad.addColorStop(0.5, 'rgba(123, 31, 162, 0.25)');
      auroraGrad.addColorStop(1, 'rgba(10, 25, 47, 0)');
      ctx.fillStyle = auroraGrad;
      ctx.fill();

      // Draw refractive light particles
      const bounds = { width, height };
      for (let i = 0; i < particles.length; i++) {
        if (!isPaused) {
          particles[i] = updateParticle(particles[i], bounds);
        }
        const p = particles[i];
        ctx.beginPath();
        ctx.arc(p.x, p.y, 1.8, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(168, 255, 235, ${p.alpha})`;
        ctx.fill();
      }

      animationFrameId = requestAnimationFrame(render);
    };

    // Event listeners
    const onPointerMove = (e: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      pointer.x = e.clientX - rect.left;
      pointer.y = e.clientY - rect.top;
      pointer.active = true;
    };

    const onPointerLeave = () => {
      pointer.active = false;
    };

    const toggleMotion = () => {
      isPaused = !isPaused;
      if (toggleBtn) {
        toggleBtn.textContent = isPaused ? 'Play Motion' : 'Pause Motion';
      }
    };

    const onKeyDown = (e: KeyboardEvent) => {
      if (e.code === 'Space' && document.activeElement === canvas) {
        e.preventDefault();
        toggleMotion();
      }
    };

    window.addEventListener('resize', resize);
    canvas.addEventListener('pointermove', onPointerMove);
    canvas.addEventListener('pointerleave', onPointerLeave);
    canvas.addEventListener('keydown', onKeyDown);
    if (toggleBtn) toggleBtn.addEventListener('click', toggleMotion);

    // Initial setup
    canvas.tabIndex = 0; // Make focusable for keyboard controls
    resize();
    render();

    // Lifecycle cleanup for Astro page transition
    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelAnimationFrame(animationFrameId);
        window.removeEventListener('resize', resize);
        if (canvas) {
          canvas.removeEventListener('pointermove', onPointerMove);
          canvas.removeEventListener('pointerleave', onPointerLeave);
          canvas.removeEventListener('keydown', onKeyDown);
        }
        if (toggleBtn) toggleBtn.removeEventListener('click', toggleMotion);
      },
      { once: true }
    );
  }
</script>

<style>
  .lab-container {
    padding-block: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .lab-header h1 {
    font-size: var(--text-3xl);
    color: var(--gray-0);
    margin-bottom: 0.5rem;
  }

  .lab-description {
    font-size: var(--text-md);
    color: var(--gray-200);
    max-width: 55ch;
    margin-bottom: 1rem;
  }

  .lab-controls-hint {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .badge {
    font-size: var(--text-xs);
    padding: 0.25rem 0.6rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 999px;
    color: var(--gray-200);
  }

  .canvas-wrapper {
    position: relative;
    width: 100%;
    height: 480px;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    outline: none;
  }

  canvas:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: -2px;
  }

  .canvas-overlay {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
  }

  .motion-toggle {
    min-height: 44px;
    min-width: 44px;
    padding: 0.5rem 1rem;
    background: rgba(10, 25, 47, 0.75);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0.5rem;
    color: var(--gray-0);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .motion-toggle:hover {
    background: rgba(10, 25, 47, 0.95);
  }

  .motion-toggle:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 2px;
  }
</style>
