---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
---

<BaseLayout
  title="Northern Lights Canvas Lab | Alexander Härenstam"
  description="Experimental interactive visual laboratory rendering math-driven Northern Lights sine waves."
  robots="noindex"
>
  <main id="main-content" class="wrapper stack gap-8">
    <Hero title="Northern Lights Lab" align="start">
      <p class="lab-dek">
        Mathematical wave refraction and dynamic particle field experiment rendered with native 2D
        Canvas.
      </p>
    </Hero>

    <section class="lab-interactive-card" aria-label="Interactive Aurora Canvas Simulation">
      <div class="canvas-wrapper">
        <canvas id="aurora-lab-canvas" aria-hidden="true"></canvas>
      </div>

      <div class="lab-controls" role="region" aria-label="Canvas controls">
        <button
          id="canvas-toggle-btn"
          class="control-btn"
          type="button"
          aria-label="Pause or play animation loop"
          aria-pressed="false"
        >
          <span class="btn-text">Pause Animation</span>
        </button>
        <span class="fps-indicator" id="fps-badge" aria-live="polite">60 FPS</span>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import {
    calculateWaveY,
    calculateParticleAttraction,
    calculateStepInterval,
  } from '../../utils/aurora-math';

  const canvas = document.getElementById('aurora-lab-canvas') as HTMLCanvasElement | null;
  const toggleBtn = document.getElementById('canvas-toggle-btn') as HTMLButtonElement | null;
  const fpsBadge = document.getElementById('fps-badge') as HTMLElement | null;

  if (canvas && canvas.parentElement) {
    if (canvas.dataset.initialized === 'true') {
      // Guard against double init
    } else {
      canvas.dataset.initialized = 'true';

      const ctx = canvas.getContext('2d');
      let animationFrameId: number | null = null;
      let isPaused = false;
      let time = 0;
      let lastTime = performance.now();
      let frameCount = 0;
      let fps = 60;

      let pointerX = -1000;
      let pointerY = -1000;

      // prefers-reduced-motion check
      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (motionQuery.matches) {
        isPaused = true;
        updateToggleButtonState();
      }

      function updateToggleButtonState() {
        if (!toggleBtn) return;
        toggleBtn.setAttribute('aria-pressed', String(isPaused));
        const btnText = toggleBtn.querySelector('.btn-text');
        if (btnText) {
          btnText.textContent = isPaused ? 'Resume Animation' : 'Pause Animation';
        }
      }

      const resize = () => {
        if (!canvas || !canvas.parentElement) return;
        const rect = canvas.parentElement.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = rect.width * dpr;
        canvas.height = rect.height * dpr;
        if (ctx) {
          ctx.scale(dpr, dpr);
        }
      };

      const handlePointerMove = (e: MouseEvent | TouchEvent) => {
        if (!canvas) return;
        const rect = canvas.getBoundingClientRect();
        if ('touches' in e && e.touches.length > 0) {
          pointerX = e.touches[0].clientX - rect.left;
          pointerY = e.touches[0].clientY - rect.top;
        } else if ('clientX' in e) {
          pointerX = e.clientX - rect.left;
          pointerY = e.clientY - rect.top;
        }
      };

      const handlePointerLeave = () => {
        pointerX = -1000;
        pointerY = -1000;
      };

      const draw = (now: number) => {
        if (!ctx || !canvas || !canvas.parentElement) return;

        const delta = now - lastTime;
        lastTime = now;
        frameCount++;
        if (frameCount % 30 === 0 && delta > 0) {
          fps = Math.round(1000 / delta);
          if (fpsBadge) fpsBadge.textContent = `${Math.min(fps, 60)} FPS`;
        }

        const rect = canvas.parentElement.getBoundingClientRect();
        const width = rect.width;
        const height = rect.height;

        ctx.clearRect(0, 0, width, height);

        if (!isPaused) {
          time += 0.015;
        }

        const step = calculateStepInterval(width);

        // Northern Lights color palette: cyan, marine blue, teal
        const waves = [
          {
            color: 'rgba(0, 210, 255, 0.35)',
            freq: 0.008,
            amp: 25,
            phase: 0,
            base: height * 0.45,
          },
          {
            color: 'rgba(0, 102, 204, 0.45)',
            freq: 0.005,
            amp: 35,
            phase: 2,
            base: height * 0.55,
          },
          {
            color: 'rgba(0, 34, 102, 0.55)',
            freq: 0.012,
            amp: 18,
            phase: 4,
            base: height * 0.65,
          },
        ];

        for (const wave of waves) {
          ctx.beginPath();
          ctx.fillStyle = wave.color;
          ctx.moveTo(0, height);

          for (let x = 0; x <= width + step; x += step) {
            let y = calculateWaveY(x, time, wave.freq, wave.amp, wave.phase, wave.base);

            // Pointer interaction refraction
            const refraction = calculateParticleAttraction(x, y, pointerX, pointerY, 120);
            y += refraction.dy;

            ctx.lineTo(x, y);
          }

          ctx.lineTo(width, height);
          ctx.closePath();
          ctx.fill();
        }

        if (!isPaused) {
          animationFrameId = requestAnimationFrame(draw);
        }
      };

      const startLoop = () => {
        if (!animationFrameId && !isPaused) {
          lastTime = performance.now();
          animationFrameId = requestAnimationFrame(draw);
        }
      };

      const stopLoop = () => {
        if (animationFrameId) {
          cancelAnimationFrame(animationFrameId);
          animationFrameId = null;
        }
      };

      toggleBtn?.addEventListener('click', () => {
        isPaused = !isPaused;
        updateToggleButtonState();
        if (isPaused) {
          stopLoop();
        } else {
          startLoop();
        }
      });

      const handleVisibilityChange = () => {
        if (document.hidden) {
          stopLoop();
        } else if (!isPaused) {
          startLoop();
        }
      };

      window.addEventListener('resize', resize);
      window.addEventListener('mousemove', handlePointerMove);
      window.addEventListener('touchmove', handlePointerMove, { passive: true });
      canvas.addEventListener('mouseleave', handlePointerLeave);
      document.addEventListener('visibilitychange', handleVisibilityChange);

      resize();
      if (!isPaused) {
        draw(performance.now());
      }

      // Cleanup on Astro page transition
      document.addEventListener(
        'astro:before-swap',
        () => {
          stopLoop();
          window.removeEventListener('resize', resize);
          window.removeEventListener('mousemove', handlePointerMove);
          window.removeEventListener('touchmove', handlePointerMove);
          canvas.removeEventListener('mouseleave', handlePointerLeave);
          document.removeEventListener('visibilitychange', handleVisibilityChange);
          canvas.dataset.initialized = 'false';
        },
        { once: true }
      );
    }
  }
</script>

<style>
  .lab-dek {
    margin: 0;
    max-width: 48ch;
    font-size: var(--text-md);
    color: var(--gray-200);
  }

  .lab-interactive-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    border-radius: 1rem;
    box-shadow: var(--shadow-md);
    backdrop-filter: blur(8px);
  }

  .canvas-wrapper {
    width: 100%;
    height: 380px;
    position: relative;
    border-radius: 0.75rem;
    overflow: hidden;
    background-color: var(--gray-999);
    border: 1px solid var(--gradient-stroke);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .lab-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .control-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 1.25rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--gray-0);
    background-color: var(--accent-regular);
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background-color var(--theme-transition);
  }

  .control-btn:hover,
  .control-btn:focus-visible {
    background-color: var(--accent-light);
    outline: 2px solid var(--accent-regular);
    outline-offset: 2px;
  }

  .fps-indicator {
    font-size: var(--text-sm);
    font-family: monospace;
    color: var(--gray-400);
    padding: 0.25rem 0.75rem;
    background: var(--gray-900);
    border-radius: 0.25rem;
    border: 1px solid var(--gray-800);
  }
</style>
