---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Aurora Refraction Light Field | Lab | Alexander Härenstam"
  description="Interactive HTML5 Canvas laboratory experiment rendering mathematical Northern Lights light wave refraction."
>
  <main id="main-content" class="wrapper stack gap-8">
    <header class="hero stack gap-2">
      <nav class="lab-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> / <span aria-current="page">Lab: Aurora Wave Field</span>
      </nav>
      <h1 class="title">Aurora Wave Field</h1>
      <p class="tagline">
        Interactive HTML5 Canvas experiment with pointer-driven cubic smoothstep light refraction
        and multi-harmonic wave physics.
      </p>
    </header>

    <section class="lab-container stack gap-4" aria-label="Interactive Canvas Laboratory">
      <div class="canvas-card">
        <div class="canvas-toolbar">
          <div class="status-indicator">
            <span class="status-dot" id="status-dot"></span>
            <span class="status-text" id="status-text">60 FPS · Active</span>
          </div>
          <div class="canvas-controls">
            <button
              id="toggle-anim-btn"
              type="button"
              class="control-btn"
              aria-label="Pause animation"
            >
              Pause
            </button>
            <button
              id="toggle-refraction-btn"
              type="button"
              class="control-btn"
              aria-label="Toggle cursor refraction effect"
            >
              Refraction: ON
            </button>
          </div>
        </div>

        <div class="canvas-wrapper">
          <canvas id="aurora-field-canvas" aria-label="Interactive Northern Lights Wave Canvas"
          ></canvas>
        </div>

        <div class="canvas-footer">
          <span class="hint-text"
            >Tip: Move cursor across canvas to refract wave nodes. Press <kbd>Space</kbd> to toggle animation.</span
          >
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import {
    calculateAuroraColor,
    computeAuroraWave,
    cubicSmoothstep,
    scaleParticleRadius,
  } from '../../utils/aurora-math';

  const canvas = document.getElementById('aurora-field-canvas') as HTMLCanvasElement | null;
  const toggleBtn = document.getElementById('toggle-anim-btn') as HTMLButtonElement | null;
  const refractionBtn = document.getElementById(
    'toggle-refraction-btn'
  ) as HTMLButtonElement | null;
  const statusDot = document.getElementById('status-dot');
  const statusText = document.getElementById('status-text');

  if (canvas) {
    const ctx = canvas.getContext('2d');
    let animationFrameId: number;
    let isPaused = false;
    let refractionEnabled = true;
    let time = 0;

    // Pointer state
    let pointerX = -9999;
    let pointerY = -9999;
    let targetPointerX = -9999;
    let targetPointerY = -9999;

    // Reduced motion preference
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const resize = () => {
      if (!canvas || !canvas.parentElement) return;
      const rect = canvas.parentElement.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      if (ctx) {
        ctx.scale(dpr, dpr);
      }
    };

    const draw = () => {
      if (!ctx || !canvas || !canvas.parentElement) return;

      const rect = canvas.parentElement.getBoundingClientRect();
      const width = rect.width;
      const height = rect.height;

      // Smooth pointer interpolation
      pointerX += (targetPointerX - pointerX) * 0.15;
      pointerY += (targetPointerY - pointerY) * 0.15;

      ctx.clearRect(0, 0, width, height);

      // Node grid setup based on viewport width
      const gridSpacing = width < 480 ? 28 : width < 768 ? 24 : 20;
      const baseNodeRadius = 2.5;
      const nodeRadius = scaleParticleRadius(baseNodeRadius, width);
      const refractionRadius = Math.min(180, width * 0.35);

      if (!isPaused && !prefersReducedMotion) {
        time += 16;
      }

      const rows = Math.ceil(height / gridSpacing) + 1;
      const cols = Math.ceil(width / gridSpacing) + 1;

      // Render grid wave nodes
      for (let r = 0; r < rows; r++) {
        const gridY = r * gridSpacing;

        for (let c = 0; c < cols; c++) {
          const gridX = c * gridSpacing;

          // Compute wave elevation displacement
          const elevation = computeAuroraWave(gridX, gridY, time, 0.008, 12);

          let offsetX = 0;
          let offsetY = elevation;

          // Apply pointer light refraction displacement using cubic smoothstep
          if (refractionEnabled) {
            const dx = gridX - pointerX;
            const dy = gridY - pointerY;
            const dist = Math.hypot(dx, dy);

            if (dist < refractionRadius) {
              const falloff = cubicSmoothstep(dist, refractionRadius);
              const push = falloff * 24;
              const angle = Math.atan2(dy, dx);
              offsetX += Math.cos(angle) * push;
              offsetY += Math.sin(angle) * push;
            }
          }

          const renderX = gridX + offsetX;
          const renderY = gridY + offsetY;

          // Normalized elevation (-1 to 1)
          const normElevation = Math.max(-1, Math.min(1, elevation / 12));
          const opacity = 0.35 + (normElevation + 1) * 0.25;

          ctx.fillStyle = calculateAuroraColor(normElevation, opacity);
          ctx.beginPath();
          ctx.arc(renderX, renderY, nodeRadius, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      if (!isPaused && !prefersReducedMotion) {
        animationFrameId = requestAnimationFrame(draw);
      }
    };

    const updateStatusUI = () => {
      if (isPaused || prefersReducedMotion) {
        if (statusDot) statusDot.classList.add('paused');
        if (statusText)
          statusText.textContent = prefersReducedMotion ? 'Static · Reduced Motion' : 'Paused';
        if (toggleBtn) {
          toggleBtn.textContent = 'Resume';
          toggleBtn.setAttribute('aria-label', 'Resume animation');
        }
      } else {
        if (statusDot) statusDot.classList.remove('paused');
        if (statusText) statusText.textContent = '60 FPS · Active';
        if (toggleBtn) {
          toggleBtn.textContent = 'Pause';
          toggleBtn.setAttribute('aria-label', 'Pause animation');
        }
      }
    };

    const handlePointerMove = (e: PointerEvent) => {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      targetPointerX = e.clientX - rect.left;
      targetPointerY = e.clientY - rect.top;
    };

    const handlePointerLeave = () => {
      targetPointerX = -9999;
      targetPointerY = -9999;
    };

    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.code === 'Space' && document.activeElement?.tagName !== 'BUTTON') {
        e.preventDefault();
        toggleAnimation();
      }
    };

    const toggleAnimation = () => {
      isPaused = !isPaused;
      updateStatusUI();
      if (!isPaused) {
        draw();
      }
    };

    const toggleRefraction = () => {
      refractionEnabled = !refractionEnabled;
      if (refractionBtn) {
        refractionBtn.textContent = `Refraction: ${refractionEnabled ? 'ON' : 'OFF'}`;
        refractionBtn.setAttribute(
          'aria-label',
          `Toggle cursor refraction effect (Currently ${refractionEnabled ? 'ON' : 'OFF'})`
        );
      }
      if (isPaused) {
        draw();
      }
    };

    // Event Bindings
    window.addEventListener('resize', resize);
    window.addEventListener('keydown', handleKeyDown);
    canvas.addEventListener('pointermove', handlePointerMove);
    canvas.addEventListener('pointerleave', handlePointerLeave);

    if (toggleBtn) toggleBtn.addEventListener('click', toggleAnimation);
    if (refractionBtn) refractionBtn.addEventListener('click', toggleRefraction);

    // Initial setup
    resize();
    if (prefersReducedMotion) {
      isPaused = true;
      updateStatusUI();
    }
    draw();

    // Astro lifecycle teardown on page transition
    document.addEventListener(
      'astro:before-swap',
      () => {
        cancelAnimationFrame(animationFrameId);
        window.removeEventListener('resize', resize);
        window.removeEventListener('keydown', handleKeyDown);
        if (canvas) {
          canvas.removeEventListener('pointermove', handlePointerMove);
          canvas.removeEventListener('pointerleave', handlePointerLeave);
        }
        if (toggleBtn) toggleBtn.removeEventListener('click', toggleAnimation);
        if (refractionBtn) refractionBtn.removeEventListener('click', toggleRefraction);
      },
      { once: true }
    );
  }
</script>

<style>
  .hero {
    padding-top: 1.5rem;
  }

  .lab-breadcrumbs {
    font-size: var(--text-sm);
    color: var(--gray-300);
  }

  .lab-breadcrumbs a {
    color: var(--accent-light);
    text-decoration: none;
  }

  .lab-breadcrumbs a:hover {
    text-decoration: underline;
  }

  .title {
    font-size: var(--text-3xl);
    color: var(--gray-0);
  }

  .tagline {
    font-size: var(--text-md);
    color: var(--gray-200);
    max-width: 50ch;
  }

  .canvas-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    background: hsla(var(--gray-999-basis), 0.5);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
  }

  .canvas-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--gray-800);
    background: hsla(var(--gray-999-basis), 0.3);
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--gray-200);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #00f2fe;
    box-shadow: 0 0 8px #00f2fe;
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .status-dot.paused {
    background-color: var(--gray-400);
    box-shadow: none;
  }

  .canvas-controls {
    display: flex;
    gap: 0.5rem;
  }

  .control-btn {
    padding: 0.35rem 0.75rem;
    font-size: var(--text-xs);
    font-family: inherit;
    font-weight: 500;
    color: var(--gray-100);
    background: hsla(var(--gray-800-basis), 0.6);
    border: 1px solid var(--gray-700);
    border-radius: 0.375rem;
    cursor: pointer;
    min-height: 36px;
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .control-btn:hover,
  .control-btn:focus-visible {
    background: hsla(var(--gray-700-basis), 0.8);
    border-color: var(--accent-regular);
    outline: none;
  }

  .canvas-wrapper {
    position: relative;
    width: 100%;
    height: 420px;
    background: #060e17;
    cursor: crosshair;
    touch-action: none;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .canvas-footer {
    padding: 0.5rem 1rem;
    border-top: 1px solid var(--gray-800);
    background: hsla(var(--gray-999-basis), 0.3);
    font-size: var(--text-xs);
    color: var(--gray-300);
  }

  kbd {
    padding: 0.1rem 0.35rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.8em;
    background: var(--gray-800);
    border: 1px solid var(--gray-700);
    border-radius: 0.25rem;
    color: var(--gray-100);
  }

  @media (max-width: 49.99em) {
    .canvas-wrapper {
      height: 320px;
    }
  }
</style>
