---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Northern Lights Aurora Waves | Laboratory | Alexander Härenstam"
  description="Interactive Northern Lights wave refraction canvas simulation built with native HTML5 Canvas and pure TypeScript math."
>
  <main id="main-content" class="wrapper stack gap-8">
    <header class="hero">
      <div class="hero-header">
        <a href="/" class="back-link">&larr; Back to home</a>
        <span class="lab-badge">Lab Experiment #01</span>
      </div>
      <h1 class="title">Northern Lights Refraction Canvas</h1>
      <p class="tagline">
        Math-driven wave composition and light refraction built with pure TypeScript and HTML5
        Canvas.
      </p>
    </header>

    <section class="lab-stage" aria-label="Interactive Canvas Experiment">
      <div class="canvas-container" id="canvas-container">
        <canvas id="aurora-canvas" aria-label="Interactive Northern Lights wave animation canvas"
        ></canvas>
        <div class="glass-overlay">
          <div class="control-row">
            <button id="pause-toggle" class="control-btn" type="button" aria-pressed="false">
              Pause Animation
            </button>
            <span class="motion-hint"
              >Tip: Hover or touch to distort light waves. Press Space to toggle motion.</span
            >
          </div>
        </div>
      </div>
    </section>

    <section class="details-grid">
      <div class="detail-card">
        <h2>Trigonometric Wave Synthesis</h2>
        <p>
          Calculates multi-layered composite sine and cosine waves natively in TypeScript to model
          fluid aurora curtain dynamics at 60fps.
        </p>
      </div>
      <div class="detail-card">
        <h2>Pointer Light Refraction</h2>
        <p>
          Vector distance algorithms calculate dynamic light displacement ripples based on real-time
          cursor or touch coordinates.
        </p>
      </div>
      <div class="detail-card">
        <h2>Accessibility & Performance</h2>
        <p>
          DPR capped at 2.0 to conserve GPU bandwidth, automatic motion reduction under <code
            >prefers-reduced-motion</code
          >, and full Astro view transition lifecycle teardown.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  import {
    calculateAuroraWaveHeight,
    calculateRefractionVector,
    getAuroraPalette,
    type WaveConfig,
  } from '../../utils/aurora-waves';

  const container = document.getElementById('canvas-container');
  const canvas = document.getElementById('aurora-canvas') as HTMLCanvasElement | null;
  const toggleBtn = document.getElementById('pause-toggle') as HTMLButtonElement | null;

  if (canvas && container) {
    const ctx = canvas.getContext('2d');
    let animationFrameId: number | null = null;
    let isPaused = false;
    let time = 0;

    let pointerX = -9999;
    let pointerY = -9999;
    let targetPointerX = -9999;
    let targetPointerY = -9999;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const waves: WaveConfig[] = [
      { frequency: 0.006, amplitude: 45, phase: 0, speed: 0.015 },
      { frequency: 0.01, amplitude: 35, phase: Math.PI / 3, speed: 0.02 },
      { frequency: 0.014, amplitude: 25, phase: Math.PI / 1.5, speed: 0.025 },
    ];

    const resize = () => {
      if (!canvas || !container) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = container.getBoundingClientRect();
      const width = rect.width || 800;
      const height = rect.height || 500;

      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      if (ctx) {
        ctx.scale(dpr, dpr);
      }
    };

    const drawFrame = () => {
      if (!ctx || !canvas || !container) return;
      const rect = container.getBoundingClientRect();
      const width = rect.width;
      const height = rect.height;

      ctx.clearRect(0, 0, width, height);

      // Smooth pointer lerp
      pointerX += (targetPointerX - pointerX) * 0.1;
      pointerY += (targetPointerY - pointerY) * 0.1;

      // Deep space gradient background
      const bgGrad = ctx.createLinearGradient(0, 0, 0, height);
      bgGrad.addColorStop(0, '#050a14');
      bgGrad.addColorStop(0.5, '#0a1628');
      bgGrad.addColorStop(1, '#030710');
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, width, height);

      const palette = getAuroraPalette(0.45);

      // Render aurora curtain waves
      waves.forEach((wave, index) => {
        ctx.beginPath();
        const baseHeight = height * (0.35 + index * 0.18);
        const color = palette[index % palette.length];

        ctx.moveTo(0, height);

        const step = 8;
        for (let x = 0; x <= width + step; x += step) {
          const waveOffsetY = calculateAuroraWaveHeight(x, time, wave);
          const refraction = calculateRefractionVector(
            x,
            baseHeight + waveOffsetY,
            pointerX,
            pointerY,
            140
          );

          const finalX = x + refraction.dx;
          const finalY = baseHeight + waveOffsetY + refraction.dy;

          if (x === 0) {
            ctx.lineTo(finalX, finalY);
          } else {
            ctx.lineTo(finalX, finalY);
          }
        }

        ctx.lineTo(width, height);
        ctx.closePath();

        const waveGrad = ctx.createLinearGradient(0, baseHeight - 60, 0, height);
        waveGrad.addColorStop(0, color);
        waveGrad.addColorStop(0.6, palette[(index + 1) % palette.length]);
        waveGrad.addColorStop(1, 'rgba(3, 7, 16, 0)');

        ctx.fillStyle = waveGrad;
        ctx.fill();
      });

      // Pointer light glow orb
      if (pointerX > 0 && pointerY > 0 && pointerX < width && pointerY < height) {
        const glowGrad = ctx.createRadialGradient(pointerX, pointerY, 0, pointerX, pointerY, 120);
        glowGrad.addColorStop(0, 'rgba(0, 210, 255, 0.35)');
        glowGrad.addColorStop(0.5, 'rgba(121, 40, 202, 0.15)');
        glowGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = glowGrad;
        ctx.beginPath();
        ctx.arc(pointerX, pointerY, 120, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const loop = () => {
      if (!isPaused && !prefersReducedMotion) {
        time += 1;
        drawFrame();
        animationFrameId = requestAnimationFrame(loop);
      }
    };

    const setPausedState = (paused: boolean) => {
      isPaused = paused;
      if (toggleBtn) {
        toggleBtn.setAttribute('aria-pressed', paused ? 'true' : 'false');
        toggleBtn.textContent = paused ? 'Resume Animation' : 'Pause Animation';
      }
      if (!isPaused && !animationFrameId && !prefersReducedMotion) {
        loop();
      } else if (isPaused && animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
    };

    const onPointerMove = (e: PointerEvent) => {
      const rect = container.getBoundingClientRect();
      targetPointerX = e.clientX - rect.left;
      targetPointerY = e.clientY - rect.top;
      if (isPaused || prefersReducedMotion) {
        drawFrame();
      }
    };

    const onPointerLeave = () => {
      targetPointerX = -9999;
      targetPointerY = -9999;
      if (isPaused || prefersReducedMotion) {
        drawFrame();
      }
    };

    const onKeyDown = (e: KeyboardEvent) => {
      if (e.code === 'Space' && document.activeElement === toggleBtn) {
        // Space already handles button click natively
        return;
      }
      if (
        e.code === 'Space' &&
        document.activeElement?.tagName !== 'BUTTON' &&
        document.activeElement?.tagName !== 'INPUT'
      ) {
        e.preventDefault();
        setPausedState(!isPaused);
      }
    };

    // Initial setup
    resize();
    drawFrame();

    if (prefersReducedMotion) {
      if (toggleBtn) {
        toggleBtn.textContent = 'Motion Reduced (System Preference)';
        toggleBtn.disabled = true;
      }
    } else {
      loop();
    }

    window.addEventListener('resize', resize);
    container.addEventListener('pointermove', onPointerMove);
    container.addEventListener('pointerleave', onPointerLeave);
    window.addEventListener('keydown', onKeyDown);

    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => setPausedState(!isPaused));
    }

    // Teardown lifecycle listener for Astro page swaps and window unloading
    const cleanup = () => {
      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
      window.removeEventListener('resize', resize);
      container.removeEventListener('pointermove', onPointerMove);
      container.removeEventListener('pointerleave', onPointerLeave);
      window.removeEventListener('keydown', onKeyDown);
    };

    document.addEventListener('astro:before-swap', cleanup, { once: true });
    window.addEventListener('unload', cleanup, { once: true });
  }
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hero-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .back-link {
    font-size: var(--text-sm);
    color: var(--gray-300);
    text-decoration: none;
    transition: color var(--theme-transition);
  }

  .back-link:hover,
  .back-link:focus-visible {
    color: var(--gray-0);
  }

  .lab-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.75rem;
    border-radius: 999rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--accent-text-over);
    background: var(--accent-regular);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .title {
    font-size: var(--text-3xl);
    color: var(--gray-0);
    margin: 0;
  }

  .tagline {
    font-size: var(--text-md);
    color: var(--gray-200);
    margin: 0;
    max-width: 60ch;
  }

  .lab-stage {
    width: 100%;
    margin-top: 1rem;
  }

  .canvas-container {
    position: relative;
    width: 100%;
    height: 480px;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid hsla(var(--gray-999-basis), 0.3);
    box-shadow: var(--shadow-lg);
    background: #050a14;
    touch-action: none;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .glass-overlay {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    padding: 0.75rem 1.25rem;
    border-radius: 0.75rem;
    background: hsla(var(--gray-999-basis), 0.65);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border: 1px solid hsla(0, 0%, 100%, 0.15);
  }

  .control-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .control-btn {
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--accent-regular);
    background: hsla(var(--gray-999-basis), 0.8);
    color: var(--gray-0);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition:
      background var(--theme-transition),
      transform var(--theme-transition);
    min-height: 44px;
  }

  .control-btn:hover {
    background: var(--accent-regular);
    color: var(--accent-text-over);
  }

  .control-btn:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 2px;
  }

  .control-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .motion-hint {
    font-size: var(--text-xs);
    color: var(--gray-300);
  }

  .details-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .detail-card {
    padding: 1.25rem;
    border-radius: 0.75rem;
    background: hsla(var(--gray-999-basis), 0.4);
    border: 1px solid hsla(var(--gray-999-basis), 0.2);
    backdrop-filter: blur(12px);
  }

  .detail-card h2 {
    font-size: var(--text-lg);
    color: var(--gray-0);
    margin: 0 0 0.5rem 0;
  }

  .detail-card p {
    font-size: var(--text-sm);
    color: var(--gray-300);
    margin: 0;
    line-height: 1.5;
  }

  @media (min-width: 50em) {
    .title {
      font-size: var(--text-4xl);
    }

    .details-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .control-btn {
      transition: none;
    }
  }
</style>
