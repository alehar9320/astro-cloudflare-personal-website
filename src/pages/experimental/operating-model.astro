---
import CallToAction from '../../components/CallToAction.astro';
import Hero from '../../components/Hero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const flagsEntry = await getEntry('flags', 'config');
if (!flagsEntry?.data.enable_operating_model) return Astro.redirect('/404/');

const pillars = [
  { t: 'Friction Elimination', d: 'Dismantle developer bottlenecks.' },
  { t: 'Cognitive Ergonomics', d: 'Minimize mental load in toolchains.' },
  { t: 'Flow Velocity', d: 'Accelerate iteration cycles.' },
];
---

<BaseLayout
  title="DevEx Operating Model"
  ogTitle="DevEx Operating Model"
  description="DevEx Operating Model"
  robots="noindex"
>
  <main id="main-content" role="main" class="wrapper stack gap-10">
    <Hero title="DevEx Operating Model" align="start">
      <p style="margin:0;color:var(--gray-200);max-width:46ch;">
        Core principles driving internal developer platforms and velocity.
      </p>
    </Hero>
    <div style="display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
      {
        pillars.map(({ t, d }) => (
          <div style="padding:1rem;border:1px solid var(--gray-800);border-radius:0.5rem;background:var(--gradient-subtle);">
            <strong style="display:block;color:var(--gray-0);">{t}</strong>
            <p style="margin:0.35rem 0 0;color:var(--gray-300);">{d}</p>
          </div>
        ))
      }
    </div>
    <CallToAction
      href="https://www.linkedin.com/in/alehar/"
      target="_blank"
      rel="noopener noreferrer"
      data-hire-event="hire_cta_click"
      data-hire-surface="operating-model">Get in touch</CallToAction
    >
  </main>
</BaseLayout>
