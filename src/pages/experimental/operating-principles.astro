---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import CallToAction from '../../components/CallToAction.astro';

const flagsEntry = await getEntry('flags', 'config');
if (!flagsEntry?.data.enable_operating_principles) return Astro.redirect('/404/');

const linkedinHref = 'https://www.linkedin.com/in/alehar/';

const principles = [
  {
    title: 'Velocity with Empathy',
    desc: 'Accelerate developer feedback loops while respecting cognitive bandwidth.',
  },
  {
    title: 'System-First Thinking',
    desc: 'Standardize primitives and design systems to eliminate repetitive toil.',
  },
  {
    title: 'Measurable Outcomes',
    desc: 'Validate hypotheses through clear metrics and real user baselines.',
  },
];
---

<BaseLayout
  title="Operating Principles | Product Manager, Developer Experience"
  description="Operating principles for developer experience and product management."
  robots="noindex"
>
  <main id="main-content" class="wrapper stack gap-8">
    <Hero title="Operating Principles" align="start">
      <p class="lede">Frameworks for developer experience, design systems, and product delivery.</p>
    </Hero>
    <div class="grid">
      {
        principles.map(({ title, desc }) => (
          <div class="card">
            <strong>{title}</strong>
            <p>{desc}</p>
          </div>
        ))
      }
    </div>
    <div class="actions">
      <CallToAction
        href={linkedinHref}
        target="_blank"
        rel="noopener noreferrer"
        data-hire-event="hire_cta_click"
        data-hire-surface="operating-principles"
      >
        Get in touch
      </CallToAction>
      <p class="cta-hint">LinkedIn · replies from me</p>
    </div>
  </main>
</BaseLayout>

<style>
  .lede {
    margin: 0;
    color: var(--gray-200);
    max-width: 46ch;
  }

  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .card {
    padding: 1rem;
    border: 1px solid var(--gray-800);
    border-radius: 0.5rem;
    background: var(--gradient-subtle);
  }

  .card strong {
    display: block;
    color: var(--gray-0);
  }

  .card p {
    margin: 0.35rem 0 0;
    color: var(--gray-300);
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin-top: 0.5rem;
    padding-bottom: var(--chat-fab-clearance);
    padding-right: var(--chat-fab-clearance);
  }

  .cta-hint {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--gray-300);
  }

  @media (min-width: 50em) {
    .actions {
      padding-bottom: 0;
      padding-right: 0;
    }
  }
</style>
