---
import CallToAction from '../../components/CallToAction.astro';
import Hero from '../../components/Hero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const flagsEntry = await getEntry('flags', 'config');
if (!flagsEntry?.data.enable_operating_rhythm) return Astro.redirect('/404/');

const linkedinHref = 'https://www.linkedin.com/in/alehar/';

const cadences = [
  {
    cadence: 'Weekly',
    focus: 'Execution velocity, blocker removal, and direct developer feedback loops.',
  },
  {
    cadence: 'Monthly',
    focus: 'Product roadmap alignment, DX metrics review, and cross-team synthesis.',
  },
  {
    cadence: 'Quarterly',
    focus: 'Strategic vision refresh, OKR evaluation, and high-impact investment planning.',
  },
];
---

<BaseLayout
  title="Operating Rhythm | Product Manager, Developer Experience at IFS"
  description="Product leadership cadence for developer experience and product impact."
  robots="noindex"
>
  <main id="main-content" class="wrapper stack gap-8">
    <Hero title="Operating Rhythm" align="start">
      <p class="lede">
        Cadence driving alignment, developer feedback, and strategic execution at scale.
      </p>
    </Hero>

    <div class="grid">
      {
        cadences.map(({ cadence, focus }) => (
          <div class="card">
            <strong>{cadence}</strong>
            <p>{focus}</p>
          </div>
        ))
      }
    </div>

    <div class="actions">
      <CallToAction
        href={linkedinHref}
        target="_blank"
        rel="noopener noreferrer"
        data-hire-event="hire_cta_click"
        data-hire-surface="operating-rhythm"
      >
        Get in touch
      </CallToAction>
      <p class="cta-hint">LinkedIn · replies from me</p>
    </div>
  </main>
</BaseLayout>

<style>
  .lede {
    margin: 0;
    color: var(--gray-200);
    max-width: 46ch;
  }

  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .card {
    padding: 1rem;
    border: 1px solid var(--gray-800);
    border-radius: 0.5rem;
    background: var(--gradient-subtle);
  }

  .card strong {
    display: block;
    color: var(--gray-0);
    font-size: var(--text-lg);
  }

  .card p {
    margin: 0.35rem 0 0;
    color: var(--gray-300);
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin-top: 0.5rem;
    padding-bottom: var(--chat-fab-clearance);
    padding-right: var(--chat-fab-clearance);
  }

  .cta-hint {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--gray-300);
  }

  @media (min-width: 50em) {
    .actions {
      padding-bottom: 0;
      padding-right: 0;
    }
  }
</style>
