---
import CallToAction from '../../components/CallToAction.astro';
import Hero from '../../components/Hero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const flagsEntry = await getEntry('flags', 'config');
if (!flagsEntry?.data.enable_product_focus_v1) return Astro.redirect('/404/');

const pillars = [
  {
    title: 'Design Systems',
    href: '/work/ifs-design-system/',
    desc: 'Shared UI components and tokens to keep product experiences consistent across Cloud.',
  },
  {
    title: 'Developer Platforms',
    desc: 'Internal tooling and platforms that streamline engineering workflows.',
  },
  {
    title: 'AI Coding Copilots',
    href: '/work/ai-coding-copilots/',
    desc: 'Internal AI coding copilots for engineering teams.',
  },
];
---

<BaseLayout
  title="Product Focus | Product Manager, Developer Experience at IFS"
  description="Where I focus as a Developer Experience PM at IFS."
  robots="noindex"
>
  <main id="main-content" class="wrapper stack gap-8">
    <Hero title="Product Focus" align="start">
      <p class="lede">Where I focus as a Developer Experience PM at IFS.</p>
    </Hero>
    <ul role="list" class="focus-list">
      {
        pillars.map(({ title, href, desc }) => (
          <li class="focus-item">
            <h2>
              {href ? (
                <a href={href} class="pillar-link">
                  {title}
                </a>
              ) : (
                title
              )}
            </h2>
            <p>{desc}</p>
          </li>
        ))
      }
    </ul>
    <div class="actions">
      <CallToAction
        href="https://www.linkedin.com/in/alehar/"
        target="_blank"
        rel="noopener noreferrer"
        data-hire-event="hire_cta_click"
        data-hire-surface="focus_cta">Get in touch</CallToAction
      >
      <p class="cta-hint">LinkedIn</p>
    </div>
  </main>
</BaseLayout>

<style>
  .lede {
    margin: 0;
    color: var(--gray-200);
    max-width: 46ch;
  }
  .focus-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .focus-item h2 {
    font-size: var(--text-md);
    color: var(--gray-0);
    margin: 0;
  }
  .pillar-link {
    color: var(--gray-0);
    text-decoration: underline;
    text-decoration-color: var(--gray-600);
    text-underline-offset: 0.2em;
  }
  .pillar-link:hover {
    color: var(--accent-regular);
    text-decoration-color: var(--accent-regular);
  }
  .pillar-link:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 2px;
  }
  .focus-item p {
    margin: 0.35rem 0 0;
    color: var(--gray-300);
    font-size: var(--text-sm);
  }
  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    padding-bottom: var(--chat-fab-clearance);
    padding-right: var(--chat-fab-clearance);
  }
  .cta-hint {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--gray-300);
  }
  @media (min-width: 50em) {
    .actions {
      padding-bottom: 0;
      padding-right: 0;
    }
  }
</style>
