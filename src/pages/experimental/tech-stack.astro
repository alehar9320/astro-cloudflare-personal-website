---
import CallToAction from '../../components/CallToAction.astro';
import Hero from '../../components/Hero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const flagsEntry = await getEntry('flags', 'config');
if (!flagsEntry?.data.enable_tech_stack) return Astro.redirect('/404/');

const linkedinHref = 'https://www.linkedin.com/in/alehar/';

const stack = [
  {
    tech: 'Astro & TypeScript',
    category: 'Frontend & System',
    rationale: 'Zero-JS static defaults with strict type safety.',
  },
  {
    tech: 'Cloudflare Workers',
    category: 'Edge Infrastructure',
    rationale: 'Sub-millisecond global execution with zero cold starts.',
  },
  {
    tech: 'Vitest & Playwright',
    category: 'Testing & Quality',
    rationale: 'Automated verification pipelines for fast iteration.',
  },
];
---

<BaseLayout
  title="Tech Stack Radar | Product Manager, Developer Experience at IFS"
  description="Developer Experience & Product Architecture Stack Radar."
  robots="noindex"
>
  <main id="main-content" role="main" class="wrapper stack gap-8">
    <Hero title="Tech Stack Radar" tagline="Core architecture & DevEx primitives." align="start" />
    <div class="grid">
      {
        stack.map(({ tech, category, rationale }) => (
          <div class="card">
            <span class="category">{category}</span>
            <strong>{tech}</strong>
            <p>{rationale}</p>
          </div>
        ))
      }
    </div>
    <div class="actions">
      <CallToAction
        href={linkedinHref}
        target="_blank"
        rel="noopener noreferrer"
        data-hire-event="hire_cta_click"
        data-hire-surface="tech-stack"
      >
        Get in touch
      </CallToAction>
      <p class="cta-hint">LinkedIn · replies from me</p>
    </div>
  </main>
</BaseLayout>

<style>
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .card {
    padding: 1rem;
    border: 1px solid var(--gray-800);
    border-radius: 0.5rem;
    background: var(--gradient-subtle);
  }

  .category {
    font-size: var(--text-xs, 0.75rem);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent-regular);
    display: block;
    margin-bottom: 0.25rem;
  }

  .card strong {
    display: block;
    color: var(--gray-0);
  }

  .card p {
    margin: 0.35rem 0 0;
    color: var(--gray-300);
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin-top: 0.5rem;
    padding-bottom: var(--chat-fab-clearance);
    padding-right: var(--chat-fab-clearance);
  }

  .cta-hint {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--gray-300);
    font-weight: 400;
  }

  @media (min-width: 50em) {
    .actions {
      padding-bottom: 0;
      padding-right: 0;
    }
  }
</style>
