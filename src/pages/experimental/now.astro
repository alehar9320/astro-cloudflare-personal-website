---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Pill from '../../components/Pill.astro';
import Icon from '../../components/Icon.astro';
import NotFoundContent from '../../components/NotFoundContent.astro';
import type { iconPaths } from '../../components/IconPaths';

const flagsEntry = await getEntry('flags', 'config');
const enabled = Boolean(flagsEntry?.data.enable_strategic_pulse);
if (!enabled) {
  Astro.response.status = 404;
}
const focus: { l: string; i: keyof typeof iconPaths }[] = [
  { l: 'Industrial AI', i: 'rocket-launch' },
  { l: 'DevEx', i: 'terminal-window' },
  { l: 'Strategic Planning', i: 'strategy' },
];
---

<BaseLayout
  title={enabled ? 'Strategic Pulse' : 'Not Found'}
  description={enabled ? 'Current focus areas.' : '404 Error — this page was not found'}
>
  {
    enabled ? (
      <main id="main-content" class="wrapper stack gap-20">
        <Hero title="Strategic Pulse" tagline="Current high-impact focus areas." align="start" />
        <div class="pulse">
          <div class="pulse-pills">
            {
              focus.map((f) => (
                <Pill>
                  <Icon icon={f.i} size="1.33em" /> {f.l}
                </Pill>
              ))
            }
          </div>
          <p class="pulse-status">
            <strong>Status:</strong> Driving enterprise AI and DevEx at IFS.
          </p>
        </div>
      </main>
    ) : (
      <NotFoundContent />
    )
  }
</BaseLayout>

<style>
  .pulse {
    border: 1px solid var(--gray-800);
    border-radius: 1.5rem;
    padding: 2rem;
    background: var(--gradient-subtle);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .pulse-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pulse-status {
    color: var(--gray-300);
  }
</style>
