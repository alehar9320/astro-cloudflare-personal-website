---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Pill from '../../components/Pill.astro';
import Icon from '../../components/Icon.astro';
import type { iconPaths } from '../../components/IconPaths';
import { getEntry } from 'astro:content';

const flagsEntry = await getEntry('flags', 'config');
if (!flagsEntry?.data.enable_strategic_pulse) return Astro.redirect('/404/');
const focus: { l: string; i: keyof typeof iconPaths }[] = [
  { l: 'Industrial AI', i: 'rocket-launch' },
  { l: 'DevEx', i: 'terminal-window' },
  { l: 'Strategic Planning', i: 'strategy' },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://harenstam.com/experimental/now/#webpage',
      url: 'https://harenstam.com/experimental/now/',
      name: 'Strategic Pulse | Alexander Härenstam',
      description:
        "A real-time overview of Alexander Härenstam's current high-impact focus areas, initiatives, and professional status at IFS.",
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: 'https://harenstam.com/',
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'Strategic Pulse',
            item: 'https://harenstam.com/experimental/now/',
          },
        ],
      },
      publisher: {
        '@type': 'Person',
        '@id': 'https://harenstam.com/#person',
        name: 'Alexander Härenstam',
      },
    },
  ],
};
---

<BaseLayout
  title="Strategic Pulse | Alexander Härenstam"
  description="A real-time overview of Alexander Härenstam's current high-impact focus areas, initiatives, and professional status at IFS."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <main id="main-content" class="wrapper stack gap-10">
    <Hero title="Strategic Pulse" tagline="Current high-impact focus areas." align="start" />
    <div class="tldr-box">
      <p>
        <strong>TL;DR:</strong> Current strategic initiatives are focused on scaling <strong
          >Industrial AI</strong
        >, optimizing <strong>Developer Experience (DevEx)</strong>, and aligning product outcomes
        with enterprise strategy at <strong>IFS</strong>.
      </p>
    </div>
    <div
      style="border: 1px solid var(--gray-800); border-radius: 1.5rem; padding: 2rem; background: var(--gradient-subtle); display: flex; flex-direction: column; gap: 1rem;"
    >
      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
        {
          focus.map((f) => (
            <Pill>
              <Icon icon={f.i} size="1.33em" /> {f.l}
            </Pill>
          ))
        }
      </div>
      <p style="color: var(--gray-300);">
        <strong>Status:</strong> Driving enterprise AI and DevEx at IFS.
      </p>
    </div>
  </main>
</BaseLayout>
