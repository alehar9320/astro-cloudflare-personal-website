---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';

const flags = await getEntry('flags', 'config');
if (!flags?.data.enable_devex_stack) return Astro.redirect('/404/');

const tools = [
  {
    category: 'IDE & Extensions',
    name: 'VS Code + GitHub Copilot',
    note: 'AI-assisted drafting & refactoring',
  },
  {
    category: 'Build & Runtime',
    name: 'Astro + Cloudflare Workers',
    note: 'Fast static output & edge delivery',
  },
  {
    category: 'Quality & Testing',
    name: 'Vitest + Playwright',
    note: 'Deterministic unit & end-to-end checks',
  },
];
---

<BaseLayout
  title="DevEx Stack"
  description="Alexander Härenstam's Developer Experience Tooling Stack."
>
  <main class="wrapper stack gap-8" style="margin-top: 4rem;">
    <Hero
      title="DevEx Tooling Stack"
      tagline="Core developer tooling for building high-velocity developer platforms."
      align="start"
    />
    <div class="grid">
      {
        tools.map((item) => (
          <section class="card">
            <span class="category">{item.category}</span>
            <h2>{item.name}</h2>
            <p>{item.note}</p>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .card {
    padding: 1.5rem;
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
  }
  .category {
    font-size: var(--text-sm);
    color: var(--accent-regular);
    font-weight: 600;
  }
  .card h2 {
    font-size: var(--text-lg);
    margin: 0.5rem 0 0.25rem;
    color: var(--gray-0);
  }
  .card p {
    color: var(--gray-300);
    font-size: var(--text-sm);
    margin: 0;
  }
</style>
