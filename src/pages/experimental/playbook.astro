---
import CallToAction from '../../components/CallToAction.astro';
import Hero from '../../components/Hero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const flagsEntry = await getEntry('flags', 'config');
if (!flagsEntry?.data.enable_devex_playbook) return Astro.redirect('/404/');

const linkedinHref = 'https://www.linkedin.com/in/alehar/';

const pillars = [
  {
    title: 'Friction Elimination',
    detail: 'Automate repetitive workflows and eradicate continuous integration bottlenecks.',
  },
  {
    title: 'System Scalability',
    detail: 'Standardize design and engineering primitives for predictable component reuse.',
  },
  {
    title: 'Velocity Loops',
    detail: 'Shorten developer feedback loops from hours to seconds across the toolchain.',
  },
];
---

<BaseLayout
  title="DevEx Playbook | Product Manager, Developer Experience at IFS"
  description="Operating pillars for developer experience and product systems."
  robots="noindex"
>
  <main id="main-content" class="wrapper stack gap-8">
    <Hero title="DevEx Playbook" align="start">
      <p class="lede">Operating pillars for developer experience and product systems.</p>
    </Hero>
    <div class="grid">
      {
        pillars.map(({ title, detail }) => (
          <div class="card">
            <strong>{title}</strong>
            <p>{detail}</p>
          </div>
        ))
      }
    </div>
    <div class="actions">
      <CallToAction
        href={linkedinHref}
        target="_blank"
        rel="noopener noreferrer"
        data-hire-event="hire_cta_click"
        data-hire-surface="playbook"
      >
        Get in touch
      </CallToAction>
      <p class="cta-hint">LinkedIn · replies from me</p>
    </div>
  </main>
</BaseLayout>

<style>
  .lede {
    margin: 0;
    color: var(--gray-200);
    max-width: 46ch;
  }
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .card {
    padding: 1rem;
    border: 1px solid var(--gray-800);
    border-radius: 0.5rem;
    background: var(--gradient-subtle);
  }
  .card strong {
    display: block;
    color: var(--gray-0);
  }
  .card p {
    margin: 0.35rem 0 0;
    color: var(--gray-300);
  }
  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin-top: 0.5rem;
    padding-bottom: var(--chat-fab-clearance);
    padding-right: var(--chat-fab-clearance);
  }
  .cta-hint {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--gray-300);
    font-weight: 400;
  }
  @media (min-width: 50em) {
    .actions {
      padding-bottom: 0;
      padding-right: 0;
    }
  }
</style>
