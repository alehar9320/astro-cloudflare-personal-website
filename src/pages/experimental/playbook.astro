---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import CallToAction from '../../components/CallToAction.astro';

const flagsEntry = await getEntry('flags', 'config');
if (!flagsEntry?.data.enable_product_playbook) return Astro.redirect('/404/');

const linkedinHref = 'https://www.linkedin.com/in/alehar/';

const plays = [
  {
    title: 'Continuous Discovery',
    description: 'Weekly user feedback loops to validate problems before building solutions.',
    icon: 'pencil-line' as const,
  },
  {
    title: 'Metric-Driven Priority',
    description: 'Tying features directly to business outcomes and developer delivery speed.',
    icon: 'strategy' as const,
  },
  {
    title: 'Frictionless DX',
    description: 'Treating internal platforms as products with zero-friction developer journeys.',
    icon: 'terminal-window' as const,
  },
];
---

<BaseLayout
  title="Product Playbook | Product Manager, Developer Experience at IFS"
  description="Product Manager, Developer Experience at IFS. Operating model and execution playbook."
  robots="noindex"
>
  <main id="main-content" role="main" class="wrapper stack gap-8">
    <Hero title="Product Playbook" align="start">
      <p class="lede">
        Product Manager, Developer Experience at IFS. Core operating frameworks for shipping impact.
      </p>
    </Hero>
    <div class="grid">
      {
        plays.map((play) => (
          <div class="card">
            <Icon icon={play.icon} color="var(--accent-regular)" size="2rem" gradient />
            <h2>{play.title}</h2>
            <p>{play.description}</p>
          </div>
        ))
      }
    </div>
    <div class="actions">
      <CallToAction
        href={linkedinHref}
        target="_blank"
        rel="noopener noreferrer"
        data-hire-event="hire_cta_click"
        data-hire-surface="playbook"
      >
        Get in touch
      </CallToAction>
      <p class="cta-hint">LinkedIn</p>
    </div>
  </main>
</BaseLayout>

<style>
  .lede {
    margin: 0;
    color: var(--gray-200);
    max-width: 46ch;
  }
  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .card {
    padding: 1.5rem;
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    border-radius: 0.5rem;
  }
  .card h2 {
    font-size: var(--text-lg);
    margin: 0.75rem 0 0.35rem;
    color: var(--gray-0);
  }
  .card p {
    margin: 0;
    color: var(--gray-300);
    line-height: 1.4;
  }
  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin-top: 0.5rem;
    padding-bottom: var(--chat-fab-clearance);
    padding-right: var(--chat-fab-clearance);
  }
  .cta-hint {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--gray-300);
    font-weight: 400;
  }
  @media (min-width: 50em) {
    .actions {
      padding-bottom: 0;
      padding-right: 0;
    }
  }
</style>
