---
import CallToAction from '../../components/CallToAction.astro';
import Hero from '../../components/Hero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const flagsEntry = await getEntry('flags', 'config');
if (!flagsEntry?.data.enable_product_frameworks) return Astro.redirect('/404/');
const frameworks = [
  { n: 'Developer Velocity Index', f: 'Eliminating workflow friction.' },
  { n: 'Jobs-to-be-Done', f: 'Structuring platform capabilities around outcomes.' },
  { n: 'Continuous Discovery', f: 'Validating technical hypotheses with user feedback.' },
];
---

<BaseLayout
  title="Product Frameworks | Product Manager, Developer Experience at IFS"
  ogTitle="Product Frameworks | Product Manager, Developer Experience at IFS"
  description="Product Manager, Developer Experience at IFS. Core DevEx product frameworks."
  robots="noindex"
>
  <main id="main-content" role="main" class="wrapper stack gap-8">
    <Hero title="Product Frameworks" align="start"
      ><p class="lede">Core frameworks for Developer Experience leadership.</p></Hero
    >
    <div class="grid">
      {
        frameworks.map(({ n, f }) => (
          <div class="card">
            <>
              <strong>{n}</strong>
              <p>{f}</p>
            </>
          </div>
        ))
      }
    </div>
    <div class="actions">
      <CallToAction
        href="https://www.linkedin.com/in/alehar/"
        target="_blank"
        rel="noopener noreferrer"
        data-hire-event="hire_cta_click"
        data-hire-surface="frameworks">Get in touch</CallToAction
      >
      <p class="cta-hint">LinkedIn</p>
    </div>
  </main>
</BaseLayout>

<style>
  .lede {
    margin: 0;
    color: var(--gray-200);
    max-width: 46ch;
  }
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .card {
    padding: 1rem;
    border: 1px solid var(--gray-800);
    border-radius: 0.5rem;
    background: var(--gradient-subtle);
  }
  .card strong {
    display: block;
    color: var(--gray-0);
  }
  .card p {
    margin: 0.35rem 0 0;
    color: var(--gray-300);
  }
  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin-top: 0.5rem;
    padding-bottom: var(--chat-fab-clearance);
    padding-right: var(--chat-fab-clearance);
  }
  .cta-hint {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--gray-300);
    font-weight: 400;
  }
  @media (min-width: 50em) {
    .actions {
      padding-bottom: 0;
      padding-right: 0;
    }
  }
  @media (forced-colors: active) {
    .card {
      border-color: CanvasText;
    }
  }
</style>
