---
import CallToAction from '../../components/CallToAction.astro';
import Hero from '../../components/Hero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

const flagsEntry = await getEntry('flags', 'config');
if (!flagsEntry?.data.enable_frameworks_pulse) return Astro.redirect('/404/');

const linkedinHref = 'https://www.linkedin.com/in/alehar/';

const frameworks = [
  {
    title: 'Value vs. Effort Matrix',
    framing: 'Prioritizing high-impact DevEx wins with clear ROI.',
  },
  {
    title: 'Jobs to Be Done (JTBD)',
    framing: 'Designing workflows around developer core outcomes.',
  },
  {
    title: 'Type 1 vs. Type 2 Decisions',
    framing: 'Decisive execution on reversible platform choices.',
  },
];
---

<BaseLayout
  title="Frameworks | Product Manager, Developer Experience at IFS"
  ogTitle="Frameworks | Product Manager, Developer Experience at IFS"
  description="Product Manager, Developer Experience at IFS. Decision frameworks."
  robots="noindex"
>
  <main id="main-content" role="main" class="wrapper stack gap-10">
    <Hero title="Decision Frameworks" align="start">
      <p class="lede">
        Product Manager, Developer Experience at IFS. Strategic frameworks applied to product
        direction.
      </p>
    </Hero>
    <div class="grid">
      {
        frameworks.map(({ title, framing }) => (
          <div class="card">
            <strong>{title}</strong>
            <p class="framing">{framing}</p>
          </div>
        ))
      }
    </div>
    <div class="actions">
      <CallToAction
        href={linkedinHref}
        target="_blank"
        rel="noopener noreferrer"
        data-hire-event="hire_cta_click"
        data-hire-surface="frameworks"
      >
        Get in touch
      </CallToAction>
      <p class="cta-hint">LinkedIn · replies from me</p>
    </div>
  </main>
</BaseLayout>

<style>
  .lede {
    margin: 0;
    color: var(--gray-200);
    max-width: 46ch;
  }

  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .card {
    padding: 1rem;
    border: 1px solid var(--gray-800);
    border-radius: 0.5rem;
    background: var(--gradient-subtle);
  }

  .card strong {
    display: block;
    color: var(--gray-0);
  }

  .card .framing {
    margin: 0.35rem 0 0;
    color: var(--gray-200);
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin-top: 0.5rem;
    /* Phone: keep the LinkedIn hire CTA out of the fixed chat FAB band. */
    padding-bottom: var(--chat-fab-clearance);
    padding-right: var(--chat-fab-clearance);
  }

  .cta-hint {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--gray-300);
    font-weight: 400;
  }

  @media (min-width: 50em) {
    .actions {
      padding-bottom: 0;
      padding-right: 0;
    }
  }
</style>
