---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import { OBJECTIVES, progressTowardTarget } from '../data/okr-h2-2026';

const pageTitle = 'Site success | Product Manager, Developer Experience at IFS';
const dek = 'How this site is measured through the end of 2026. Progress against real baselines.';
const lede =
  'How this site is measured through the end of 2026. Progress against baselines — not a career scoreboard.';
const meta = 'H2 2026 · baselines frozen 29 Aug 2026 · current refreshed weekly';
---

<BaseLayout title={pageTitle} ogTitle={pageTitle} description={dek}>
  <div class="stack gap-20">
    <main id="main-content" class="okr-page stack gap-8">
      <Hero title="Site success" tagline={lede} align="start" />
      <p class="okr-meta">{meta}</p>
      {
        OBJECTIVES.map((objective) => (
          <section class="objective" aria-labelledby={objective.id}>
            <h2 id={objective.id}>{objective.title}</h2>
            {objective.results.map((kr) => {
              const pct = progressTowardTarget(kr);
              return (
                <article class="kr" aria-labelledby={`${kr.id}-label`}>
                  <p class="kr-head">
                    <span id={`${kr.id}-label`} title={kr.tooltip}>{kr.label}</span>
                    <span class="kr-window">{kr.window}</span>
                  </p>
                  <dl class="kr-cols">
                    <div>
                      <dt>Baseline</dt>
                      <dd>{kr.baselineLabel}</dd>
                    </div>
                    <div>
                      <dt>Current</dt>
                      <dd>{kr.currentLabel}</dd>
                    </div>
                    <div>
                      <dt>Target</dt>
                      <dd>{kr.targetLabel}</dd>
                    </div>
                  </dl>
                  {pct !== null && (
                    <div
                      class="kr-bar"
                      role="progressbar"
                      aria-valuemin="0"
                      aria-valuemax="100"
                      aria-valuenow={Math.round(pct)}
                      aria-label={`${kr.label} progress`}
                    >
                      <span class="kr-bar-fill" style={`width: ${Math.min(100, pct)}%`} />
                    </div>
                  )}
                  {kr.note && <p class="kr-note">{kr.note}</p>}
                </article>
              );
            })}
            {objective.supporting.map((line) => (
              <p class="kr-support">{line}</p>
            ))}
          </section>
        ))
      }
    </main>
    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .okr-page {
    width: min(52rem, calc(100vw - 3rem));
    margin-inline: auto;
    padding-bottom: var(--chat-fab-clearance);
  }

  .okr-meta {
    margin: 0;
    max-width: 46ch;
    font-size: var(--text-sm);
    color: var(--gray-300);
    line-height: 1.45;
  }

  .objective {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 46ch;
  }

  .objective h2 {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--gray-0);
    letter-spacing: -0.01em;
  }

  .kr {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .kr-head {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    align-items: baseline;
    font-size: var(--text-md);
    color: var(--gray-0);
  }

  .kr-window {
    font-size: var(--text-sm);
    color: var(--gray-300);
  }

  .kr-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0;
  }

  .kr-cols div {
    min-width: 0;
  }

  .kr-cols dt {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--gray-300);
  }

  .kr-cols dd {
    margin: 0;
    font-size: var(--text-md);
    color: var(--gray-0);
    overflow-wrap: anywhere;
  }

  .kr-bar {
    display: block;
    height: 0.25rem;
    width: 100%;
    background: hsla(var(--gray-999-basis), 0.12);
    border-radius: 0.25rem;
    overflow: hidden;
  }

  .kr-bar-fill {
    display: block;
    height: 100%;
    background: var(--accent-regular);
    border-radius: 0.25rem;
  }

  @media (forced-colors: active) {
    .kr-bar {
      border: 1px solid CanvasText;
    }
    .kr-bar-fill {
      background-color: Highlight;
    }
  }

  .kr-note,
  .kr-support {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--gray-300);
    line-height: 1.45;
  }

  @media (min-width: 50em) {
    .okr-page {
      padding-bottom: 0;
    }
  }
</style>