---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import { fetchGitHubReleases, formatReleaseDate, splitReleaseBody } from '../utils/github-releases';

// Fetch releases at build-time (⚡ Bolt: performance-obsessed build-time rendering)
const releases = await fetchGitHubReleases();

// Generate summary from prioritized items
const summaryItems = releases
  .flatMap((r) => splitReleaseBody(r.body))
  .filter((item) => {
    const msg = item.message.toLowerCase();
    return (
      msg.includes('feat') ||
      msg.includes('fix') ||
      msg.includes('scribe') ||
      msg.includes('oracle') ||
      msg.includes('sentinel') ||
      msg.includes('palette') ||
      msg.includes('vantage') ||
      msg.includes('bolt')
    );
  })
  .slice(0, 3)
  .map((item) => item.message);

// Fallback to first 3 items if no prioritized items found
if (summaryItems.length === 0) {
  summaryItems.push(
    ...releases
      .flatMap((r) => splitReleaseBody(r.body))
      .slice(0, 3)
      .map((item) => item.message)
  );
}

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://harenstam.com/whats-new/#webpage',
      url: 'https://harenstam.com/whats-new/',
      name: "What's New | Alexander Härenstam",
      description:
        'A real-time log of project milestones, technical refinements, and portfolio updates.',
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: 'https://harenstam.com/',
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: "What's New",
            item: 'https://harenstam.com/whats-new/',
          },
        ],
      },
      publisher: {
        '@type': 'Person',
        '@id': 'https://harenstam.com/#person',
        name: 'Alexander Härenstam',
      },
    },
  ],
};
---

<BaseLayout title="What's New | Alexander Härenstam" description="Changelog and recent updates">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="stack gap-20">
    <main id="main-content" class="wrapper stack gap-8">
      <Hero
        title="What's New"
        tagline="A real-time log of project milestones, technical refinements, and portfolio updates."
        align="start"
      />

      <div class="content">
        <div data-release-summary>
          {
            summaryItems.length > 0 ? (
              <div class="tldr-box">
                <p>
                  <strong>Recent Highlights:</strong> {summaryItems.join('; ')}.
                </p>
              </div>
            ) : (
              <div class="tldr-box">
                <p>
                  <strong>Topical Anchor:</strong> This page serves as the
                  <strong>Source of Truth</strong> for the latest technical refinements, portfolio
                  updates, and professional milestones.
                </p>
              </div>
            )
          }
        </div>
        <div class="release-list">
          {
            releases.length === 0 ? (
              <p class="release-status">
                Project history is currently unavailable.{' '}
                <a href="https://github.com/alehar9320/astro-cloudflare-personal-website/releases">
                  View GitHub Releases
                </a>
                .
              </p>
            ) : (
              releases.map((release) => {
                const bodyItems = splitReleaseBody(release.body);
                return (
                  <article class="release-card">
                    <h2>{release.version}</h2>
                    <p class="release-meta">{formatReleaseDate(release.publishedAt)}</p>
                    {bodyItems.length > 0 ? (
                      <ul>
                        {bodyItems.map((item) => (
                          <li>
                            {item.hash && item.url ? (
                              <>
                                <code class="commit-hash">
                                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                                    {item.hash}
                                  </a>
                                </code>{' '}
                                {item.message}
                              </>
                            ) : (
                              item.message
                            )}
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="release-status">No release notes published for this version.</p>
                    )}
                    <a href={release.url} class="release-link">
                      View on GitHub
                    </a>
                  </article>
                );
              })
            )
          }
        </div>
      </div>
    </main>
    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .content {
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    border-radius: 1.5rem;
    padding: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  .release-list {
    display: grid;
    gap: 1.5rem;
  }

  .release-card {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--gray-800);
  }

  .release-card:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .release-card h2 {
    font-size: var(--text-xl);
    margin-bottom: 0.35rem;
    color: var(--gray-100);
  }

  .release-meta {
    color: var(--gray-400);
    margin-bottom: 1rem;
  }

  .release-card ul {
    margin-left: 1.5rem;
    list-style-type: disc;
    margin-bottom: 1rem;
    color: var(--gray-300);
  }

  .release-card li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .release-status {
    color: var(--gray-300);
    line-height: 1.6;
  }

  .release-link {
    display: inline-block;
    margin-top: 0.25rem;
  }

  .commit-hash {
    background: var(--gray-800);
    padding: 0.1rem 0.3rem;
    border-radius: 0.25rem;
    font-size: 0.85em;
    font-family: monospace;
    margin-right: 0.25rem;
  }

  .commit-hash a {
    text-decoration: none;
    color: var(--accent-regular);
  }

  :root.theme-dark .commit-hash a {
    color: var(--accent-dark);
  }
</style>
