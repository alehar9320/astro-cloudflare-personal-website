---
export const prerender = false;

import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import { LATEST_RELEASE_SNAPSHOT } from '../data/latest-release';
import { fetchGitHubReleases } from '../utils/github-releases';
import { toVisitorChangelogTitle, toVisitorRelease } from '../utils/visitor-changelog';
import { buildWhatsNewGlance } from '../utils/whats-new-glance';

interface Bindings {
  GITHUB_TOKEN?: string;
}

function readEnv(): Bindings {
  try {
    if (env && typeof env === 'object') return env as Bindings;
  } catch {
    // cloudflare:workers env is the only binding surface after adapter v13.
  }
  return {};
}

const token = readEnv().GITHUB_TOKEN?.trim();
const fetched = await fetchGitHubReleases(fetch, undefined, token ? { token } : undefined);
const baseReleases = fetched.length > 0 ? fetched : [LATEST_RELEASE_SNAPSHOT];
const visitorReleases = baseReleases.map((release) => {
  const visitor = toVisitorRelease(release);
  return {
    ...visitor,
    body: visitor.body
      .split('\n')
      .map((line) => {
        const bullet = line.match(/^([-*+]\s+)(.*)$/);
        if (!bullet) return toVisitorChangelogTitle(line);
        return `${bullet[1]}${toVisitorChangelogTitle(bullet[2])}`;
      })
      .join('\n'),
  };
});
const glance = buildWhatsNewGlance(visitorReleases);

const dek = 'What you can see on this site lately.';
const pageTitle = "What's New | Product Manager, Developer Experience at IFS";

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://me.alehar.workers.dev/whats-new/#webpage',
      url: 'https://me.alehar.workers.dev/whats-new/',
      name: pageTitle,
      description: dek,
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: 'https://me.alehar.workers.dev/',
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: "What's New",
            item: 'https://me.alehar.workers.dev/whats-new/',
          },
        ],
      },
      publisher: {
        '@type': 'Person',
        '@id': 'https://me.alehar.workers.dev/#person',
        name: 'Alexander Härenstam',
      },
    },
  ],
};
---

<BaseLayout
  title="What's New | Product Manager, Developer Experience at IFS"
  ogTitle="What's New | Product Manager, Developer Experience at IFS"
  description={`${dek} Product Manager, Developer Experience at IFS.`}
  robots="noindex"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="stack gap-20">
    <main id="main-content" class="glance stack gap-8">
      <Hero title="What's New" tagline={dek} align="start" />

      {
        glance.thisWeek.length > 0 && (
          <section class="this-week" aria-labelledby="this-week-heading">
            <h2 id="this-week-heading">This week</h2>
            <ul>
              {glance.thisWeek.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        glance.groups.length > 0 && (
          <section class="last-30" aria-labelledby="last-30-heading">
            <h2 id="last-30-heading">Last 30 days</h2>
            <div class="clusters">
              {glance.groups.map((group) => (
                <div class="group">
                  <h3>{group.heading}</h3>
                  <ul>
                    {group.lines.map((line) => (
                      <li>{line}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        )
      }

      <p class="history">
        <a
          class="history-link"
          href="https://github.com/alehar9320/astro-cloudflare-personal-website/commits"
        >
          Full history on GitHub
        </a>
      </p>
    </main>
    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .glance {
    width: min(52rem, calc(100vw - 3rem));
    margin-inline: auto;
  }

  .this-week,
  .last-30 {
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    border-radius: 1.5rem;
    padding: 1.5rem 2rem;
    box-shadow: var(--shadow-sm);
  }

  .this-week h2,
  .last-30 h2 {
    font-size: var(--text-xl);
    color: var(--gray-100);
    margin-bottom: 0.75rem;
  }

  .this-week ul,
  .last-30 ul {
    margin-left: 1.25rem;
    list-style-type: disc;
    color: var(--gray-300);
  }

  .this-week li,
  .last-30 li {
    margin-bottom: 0.4rem;
    line-height: 1.6;
  }

  .last-30 .clusters {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 50em) {
    /* site desktop breakpoint from global.css */
    .last-30 .clusters {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .last-30 .group {
      flex: 1 1 0;
      min-width: 0;
    }
  }

  .group h3 {
    font-size: var(--text-lg);
    color: var(--gray-100);
    margin-bottom: 0.5rem;
  }

  .history {
    margin-top: 0.5rem;
  }

  :global(.history-link) {
    color: var(--link-color);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition:
      text-decoration-color var(--theme-transition),
      color var(--theme-transition);
  }

  :global(.history-link:hover) {
    text-decoration-color: currentColor;
  }

  :global(.history-link:focus-visible) {
    text-decoration-color: currentColor;
    outline: 2px solid var(--accent-regular);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  /* Narrow phone (375): compress glance rhythm so Last-30 outcome lines clear the docked composer. */
  @media (max-width: 30em) {
    .glance {
      gap: 0.5rem;
    }

    .this-week,
    .last-30 {
      padding: 0.6rem 1rem;
    }

    .this-week h2,
    .last-30 h2 {
      margin-bottom: 0.35rem;
    }

    .last-30 .clusters {
      gap: 0.45rem;
    }

    .group h3 {
      margin-bottom: 0.25rem;
    }

    .this-week li,
    .last-30 li {
      margin-bottom: 0.15rem;
    }

    .history {
      margin-top: 0.25rem;
    }
  }
</style>
