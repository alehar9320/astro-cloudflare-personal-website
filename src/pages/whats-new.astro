---
import { env } from 'cloudflare:workers';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
import { LATEST_RELEASE_SNAPSHOT } from '../data/latest-release';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchGitHubReleases, formatReleaseDate, type SiteRelease } from '../utils/github-releases';
import { toVisitorChangelogTitle, toVisitorRelease } from '../utils/visitor-changelog';
import { buildWhatsNewPage } from '../utils/whats-new-exec';

export const prerender = false;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://me.alehar.workers.dev/whats-new/#webpage',
      url: 'https://me.alehar.workers.dev/whats-new/',
      name: "What's New | Product Manager, Developer Experience at IFS",
      description: 'A public changelog of this site.',
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: 'https://me.alehar.workers.dev/',
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: "What's New",
            item: 'https://me.alehar.workers.dev/whats-new/',
          },
        ],
      },
      publisher: {
        '@type': 'Person',
        '@id': 'https://me.alehar.workers.dev/#person',
        name: 'Alexander Härenstam',
      },
    },
  ],
};

interface WhatsNewEnv {
  GITHUB_TOKEN?: string;
}

function readEnv(): WhatsNewEnv {
  try {
    if (env && typeof env === 'object') return env as WhatsNewEnv;
  } catch {
    // cloudflare:workers env is the only binding surface after adapter v13.
  }
  return {};
}

const bindings = readEnv();
const token = bindings.GITHUB_TOKEN?.trim();

let fetched: SiteRelease[] = [];
try {
  fetched = await fetchGitHubReleases(fetch, undefined, token ? { token } : undefined);
} catch {
  fetched = [];
}

const baseReleases = fetched.length > 0 ? fetched : [LATEST_RELEASE_SNAPSHOT];
const releases = baseReleases.map(toVisitorRelease);
const now = new Date();
const pageModel = buildWhatsNewPage(releases, now);
const olderUpdatesHref =
  'https://github.com/alehar9320/astro-cloudflare-personal-website/commits/main';
---

<BaseLayout
  title="What's New | Product Manager, Developer Experience at IFS"
  ogTitle="What's New | Product Manager, Developer Experience at IFS"
  description="A public changelog of this site. Product Manager, Developer Experience at IFS."
  robots="noindex"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="stack gap-20">
    <main id="main-content" class="wrapper stack gap-8">
      <Hero title="What's New" tagline="A public changelog of this site." align="start" />

      <div class="content">
        {
          pageModel.thisWeek.length > 0 && (
            <section class="this-week">
              <h2>This week</h2>
              <p class="this-week-strip">
                {pageModel.thisWeek.map((release) => release.version).join(' · ')}
              </p>
            </section>
          )
        }

        {
          pageModel.latest && (
            <section class="exec-summary">
              <h2>Last 30 days</h2>
              <p class="exec-lead">
                {pageModel.latest.version}
                {pageModel.latest.publishedAt
                  ? ` · ${formatReleaseDate(pageModel.latest.publishedAt)}`
                  : ''}
                {pageModel.latestLead ? `. ${pageModel.latestLead}.` : '.'}
              </p>
              {pageModel.groups.map((group) => (
                <div>
                  {group.label && <h3>{group.label}</h3>}
                  <ul>
                    {group.titles.map((title) => (
                      <li>{toVisitorChangelogTitle(title)}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </section>
          )
        }

        {
          pageModel.last30.length === 0 && (
            <p class="release-status">Site updates are currently unavailable.</p>
          )
        }

        <div class="release-list">
          {
            pageModel.last30.map((release) => (
              <article class="release-card">
                <h2>{release.version}</h2>
                <p class="release-meta">{formatReleaseDate(release.publishedAt)}</p>
                <a href={release.url} class="release-link">
                  {`View ${release.version} on GitHub`}
                </a>
              </article>
            ))
          }
        </div>

        <p class="older-updates release-status">
          <a href={olderUpdatesHref}>Older updates on GitHub</a>
        </p>

        <noscript>
          <p class="release-status">
            Release history is available on
            <a href="https://github.com/alehar9320/astro-cloudflare-personal-website/releases">
              GitHub Releases
            </a>.
          </p>
        </noscript>
      </div>
    </main>
    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .content {
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    border-radius: 1.5rem;
    padding: 2.5rem;
    box-shadow: var(--shadow-sm);
  }

  .this-week,
  .exec-summary {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--gray-800);
  }

  .this-week h2,
  .exec-summary h2,
  .release-card h2 {
    font-size: var(--text-xl);
    margin-bottom: 0.35rem;
    color: var(--gray-100);
  }

  .exec-summary h3 {
    margin: 1rem 0 0.5rem;
    color: var(--gray-100);
  }

  .this-week-strip,
  .exec-lead {
    color: var(--gray-300);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .exec-summary ul {
    margin-left: 1.5rem;
    list-style-type: disc;
    margin-bottom: 0.75rem;
    color: var(--gray-300);
  }

  .exec-summary li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .release-list {
    display: grid;
    gap: 1.5rem;
  }

  .release-card {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--gray-800);
  }

  .release-card:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .release-meta {
    color: var(--gray-400);
    margin-bottom: 1rem;
  }

  .release-status {
    color: var(--gray-300);
    line-height: 1.6;
  }

  .older-updates {
    margin-top: 1.5rem;
  }

  :global(.release-link),
  :global(.release-status a) {
    display: inline-block;
    margin-top: 0.25rem;
    color: var(--link-color);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition:
      text-decoration-color var(--theme-transition),
      color var(--theme-transition);
  }

  :global(.release-link:hover),
  :global(.release-status a:hover) {
    text-decoration-color: currentColor;
  }

  :global(.release-link:focus-visible),
  :global(.release-status a:focus-visible) {
    text-decoration-color: currentColor;
    outline: 2px solid var(--accent-regular);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  .commit-hash {
    background: var(--gray-800);
    padding: 0.1rem 0.3rem;
    border-radius: 0.25rem;
    font-size: 0.85em;
    font-family: monospace;
    margin-right: 0.25rem;
  }

  .commit-hash a {
    text-decoration: none;
    color: var(--accent-regular);
  }

  :root.theme-dark .commit-hash a {
    color: var(--accent-dark);
  }
</style>