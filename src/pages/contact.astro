---
import CallToAction from '../components/CallToAction.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import { hire, hireMailto } from '../data/hire';
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://harenstam.com/#person',
      name: 'Alexander Härenstam',
      jobTitle: 'Strategic Product Leader',
      email: hire.email,
      url: 'https://harenstam.com/',
      sameAs: [hire.linkedinHref, 'https://github.com/alehar9320'],
    },
    {
      '@type': 'ContactPage',
      '@id': 'https://harenstam.com/contact/#webpage',
      url: 'https://harenstam.com/contact/',
      name: 'Get in touch | Alexander Härenstam',
      about: { '@id': 'https://harenstam.com/#person' },
      description: hire.availability,
    },
  ],
};
---

<BaseLayout title="Get in touch | Alexander Härenstam" description={hire.availability}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="stack gap-20">
    <main id="main-content" class="wrapper contact">
      <Hero title="Get in touch" align="start">
        <p class="availability">{hire.availability}</p>
        <p class="mailto">
          <a href={hireMailto}>{hire.email}</a>
        </p>
        <div class="actions">
          <CallToAction
            href={hire.cvHref}
            download
            data-event="cv_download"
            data-surface="contact_page"
          >
            Download CV
            <Icon icon="download-simple" size="1.2em" />
          </CallToAction>
          <a
            class="linkedin-link"
            href={hire.linkedinHref}
            target="_blank"
            rel="noopener noreferrer"
            data-event="linkedin_click"
            data-surface="contact_page"
          >
            LinkedIn
          </a>
        </div>
      </Hero>
    </main>
  </div>
</BaseLayout>

<script>
  import { trackHireEvent } from '../utils/hire-analytics';
  trackHireEvent('contact_page_view', 'contact_page');
</script>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .availability {
    margin: 0;
    color: var(--gray-200);
    max-width: 46ch;
    font-size: var(--text-lg);
  }

  .mailto a {
    color: var(--accent-dark);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition:
      color var(--theme-transition),
      text-decoration-color var(--theme-transition);
  }

  .mailto a:hover,
  .mailto a:focus-visible {
    color: var(--accent-text-over);
    text-decoration-color: currentColor;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .linkedin-link {
    color: var(--gray-300);
    font-size: var(--text-md);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition:
      color var(--theme-transition),
      text-decoration-color var(--theme-transition);
  }

  .linkedin-link:hover,
  .linkedin-link:focus-visible {
    color: var(--accent-text-over);
    text-decoration-color: currentColor;
  }

  .mailto a:focus-visible,
  .linkedin-link:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 4px;
  }
</style>
