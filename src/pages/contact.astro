---
import CallToAction from '../components/CallToAction.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const linkedinHref = 'https://www.linkedin.com/in/alehar/';
const pageTitle = 'Get in touch | Product Manager, Developer Experience at IFS';
const dek = 'Product Manager, Developer Experience at IFS. Get in touch on LinkedIn.';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': 'https://me.alehar.workers.dev/contact/#webpage',
      url: 'https://me.alehar.workers.dev/contact/',
      name: pageTitle,
      description: dek,
      about: {
        '@type': 'Person',
        '@id': 'https://me.alehar.workers.dev/#person',
        name: 'Alexander Härenstam',
        jobTitle: 'Product Manager, Developer Experience at IFS',
        sameAs: ['https://www.linkedin.com/in/alehar/'],
      },
      breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: 'https://me.alehar.workers.dev/',
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'Get in touch',
            item: 'https://me.alehar.workers.dev/contact/',
          },
        ],
      },
      publisher: {
        '@type': 'Person',
        '@id': 'https://me.alehar.workers.dev/#person',
        name: 'Alexander Härenstam',
      },
    },
  ],
};
---

<BaseLayout
  title="Get in touch | Product Manager, Developer Experience at IFS"
  description="Product Manager, Developer Experience at IFS. Get in touch on LinkedIn."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <main id="main-content" class="wrapper stack gap-8">
    <Hero title="Get in touch" align="start">
      <div class="tldr-box">
        <p>
          <strong>TL;DR:</strong> Alexander Härenstam is a Product Manager, Developer Experience at IFS
          based in Stockholm, Sweden. Connect directly via LinkedIn for collaboration or inquiries.
        </p>
      </div>
      <p class="availability">Product Manager, Developer Experience at IFS.</p>
      <div class="actions">
        <CallToAction
          href={linkedinHref}
          target="_blank"
          rel="noopener noreferrer"
          data-hire-event="linkedin_click"
          data-hire-surface="contact_page"
        >
          Get in touch
        </CallToAction>
        <p class="cta-hint">LinkedIn</p>
      </div>
    </Hero>
  </main>
</BaseLayout>

<script>
  import { trackHireEvent } from '../utils/hire-analytics';
  trackHireEvent('contact_page_view', 'contact_page');
</script>

<style>
  .availability {
    color: var(--gray-200);
    max-width: 46ch;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin-top: 0.5rem;
    /* Phone: keep the LinkedIn hire CTA out of the fixed chat FAB band. */
    padding-bottom: var(--chat-fab-clearance);
    padding-right: var(--chat-fab-clearance);
  }

  .actions :global(a) {
    min-height: 44px;
    min-width: 44px;
  }

  .cta-hint {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--gray-300);
    font-weight: 400;
  }

  @media (min-width: 50em) {
    .actions {
      padding-bottom: 0;
      padding-right: 0;
    }
  }
</style>
