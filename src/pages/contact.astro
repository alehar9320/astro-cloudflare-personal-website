---
import CallToAction from '../components/CallToAction.astro';
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const email = 'hello@alehar.dev';
const linkedinHref = 'https://www.linkedin.com/in/alehar/';
---

<BaseLayout
  title="Get in touch | Alexander Härenstam"
  description="Open to conversations about product leadership, DevEx, and Industrial AI."
>
  <main id="main-content" class="wrapper stack gap-8">
    <Hero title="Get in touch" align="start">
      <p class="availability">
        Open to conversations about product leadership, DevEx, and Industrial AI.
      </p>
      <p class="mailto">
        <a
          href={`mailto:${email}`}
          data-hire-event="hire_cta_click"
          data-hire-surface="contact_page">{email}</a
        >
      </p>
      <div class="actions">
        <CallToAction
          href="/alexander-harenstam-cv.pdf"
          download="alexander-harenstam-cv.pdf"
          data-hire-event="cv_download"
          data-hire-surface="contact_page"
        >
          Download CV
        </CallToAction>
        <a
          class="linkedin"
          href={linkedinHref}
          target="_blank"
          rel="noopener noreferrer"
          data-hire-event="linkedin_click"
          data-hire-surface="contact_page"
        >
          LinkedIn
        </a>
      </div>
    </Hero>
  </main>
</BaseLayout>

<script>
  import { trackHireEvent } from '../utils/hire-analytics';
  trackHireEvent('contact_page_view', 'contact_page');
</script>

<style>
  .availability {
    color: var(--gray-200);
    max-width: 46ch;
  }

  .mailto a {
    color: var(--accent-dark);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition:
      color var(--theme-transition),
      text-decoration-color var(--theme-transition);
  }

  .mailto a:hover,
  .mailto a:focus-visible {
    color: var(--accent-text-over);
    text-decoration-color: currentColor;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .linkedin {
    color: var(--gray-300);
    font-size: var(--text-md);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition:
      color var(--theme-transition),
      text-decoration-color var(--theme-transition);
  }

  .linkedin:hover,
  .linkedin:focus-visible {
    color: var(--accent-text-over);
    text-decoration-color: currentColor;
  }

  .mailto a:focus-visible,
  .linkedin:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 4px;
  }
</style>
