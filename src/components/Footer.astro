---
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="group">
    <p>
      <a
        href="https://www.google.com/maps/place/Stockholm/"
        target="_blank"
        rel="noopener noreferrer">Stockholm</a
      >, <a
        href="https://www.google.com/maps/place/Sweden/"
        target="_blank"
        rel="noopener noreferrer">Sweden</a
      >
    </p>
    <p>&copy; {currentYear} Alexander Härenstam</p>
    <div class="colophon">
      <a href="/whats-new/">What's New</a>{' · '}<a href="/this-site/">This site</a>
      {' · '}<a href="/roadmap/">What's next</a>
      {' · '}<a href="/okr/">Site success</a>
    </div>
  </div>
  <p class="socials">
    <a href="https://www.linkedin.com/in/alehar/" target="_blank" rel="noopener noreferrer">
      LinkedIn</a
    >
    <a
      href="https://blog.ifs.com/author/alexander-harenstam/"
      target="_blank"
      rel="noopener noreferrer"
    >
      IFS Blog</a
    >
    <a href="https://github.com/alehar9320" target="_blank" rel="noopener noreferrer"> GitHub</a>
  </p>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-top: auto;
    padding: 3rem 2rem var(--chat-fab-clearance);
    text-align: center;
    color: var(--gray-400);
    font-size: var(--text-sm);
  }

  footer a {
    color: var(--gray-400);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  footer a:hover,
  footer a:focus-visible {
    text-decoration-color: currentColor;
  }

  footer a:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .socials {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .version-link {
    font-family: var(--font-brand);
    font-size: var(--text-sm);
    color: var(--gray-400);
    text-decoration: none;
    transition: color var(--theme-transition);
  }

  .version-link:hover,
  .version-link:focus {
    color: var(--gray-200);
  }

  .version-link:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  .separator {
    padding: 0 0.5rem;
    color: var(--gray-600);
  }

  .colophon {
    position: relative;
    overflow: visible;
    font-size: 0.75rem;
    color: var(--gray-600);
    line-height: 1.5;
  }

  @media (min-width: 50em) {
    footer {
      flex-direction: row;
      justify-content: space-between;
      padding: 2.5rem 5rem var(--chat-fab-clearance);
      padding-right: var(--chat-fab-clearance);
    }

    .group {
      flex-direction: row;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .socials {
      justify-content: flex-end;
    }
  }
</style>
