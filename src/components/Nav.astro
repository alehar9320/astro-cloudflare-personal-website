---
import Icon from './Icon.astro';
import { getEntry } from 'astro:content';
import type { iconPaths } from './IconPaths';
import ThemeToggle from './ThemeToggle.astro';

const flagsEntry = await getEntry('flags', 'config');
const isLogoWobbleEnabled = flagsEntry?.data.enable_logo_wobble_v1 ?? false;

/** Main menu items */
const textLinks: { label: string; href: string; event?: string; surface?: string }[] = [
  { label: 'Home', href: '/' },
  { label: 'Strategic Portfolio', href: '/work/' },
  { label: 'Biography', href: '/biography/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/', event: 'hire_cta_click', surface: 'nav' },
];

const iconLinks: {
  label: string;
  href: string;
  icon: keyof typeof iconPaths;
  event?: string;
  surface?: string;
}[] = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/alehar',
    icon: 'linkedin-logo',
    event: 'linkedin_click',
    surface: 'nav',
  },
  {
    label: 'IFS Blog',
    href: 'https://blog.ifs.com/author/alexander-harenstam/',
    icon: 'pencil-line',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/alehar9320',
    icon: 'github-logo',
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/alle12393',
    icon: 'instagram-logo',
  },
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/alehar9320/',
    icon: 'facebook-logo',
  },
];

/** Test if a link is pointing to the current page. */
const isCurrentPage = (href: string) => {
  let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
  if (pathname.at(0) !== '/') pathname = '/' + pathname;
  if (pathname.at(-1) !== '/') pathname += '/';
  return pathname === href || (href !== '/' && pathname.startsWith(href));
};
---

<nav aria-label="Main">
  <div class="menu-header">
    <a href="/" class:list={['site-title', { 'logo-wobble': isLogoWobbleEnabled }]}>
      <Icon icon="terminal-window" color="var(--accent-regular)" size="1.6em" gradient />
      Alexander Härenstam
    </a>
    <menu-button>
      <template>
        <button class="menu-button" aria-expanded="false">
          <span class="sr-only">Menu</span>
          <Icon icon="list" />
        </button>
      </template>
    </menu-button>
  </div>
  <noscript>
    <ul class="nav-items">
      {
        textLinks.map(({ label, href, event, surface }) => (
          <li>
            <a
              aria-current={isCurrentPage(href) ? 'page' : null}
              class="link"
              href={href}
              data-hire-event={event}
              data-hire-surface={surface}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </noscript>
  <noscript>
    <div class="menu-footer">
      <div class="socials">
        {
          iconLinks.map(({ href, icon, label, event, surface }) => (
            <a href={href} class="social" data-hire-event={event} data-hire-surface={surface}>
              <span class="sr-only">{label}</span>
              <Icon icon={icon} />
            </a>
          ))
        }
      </div>
    </div>
  </noscript>
  <div id="menu-content" hidden>
    <ul class="nav-items">
      {
        textLinks.map(({ label, href, event, surface }) => (
          <li>
            <a
              aria-current={isCurrentPage(href) ? 'page' : null}
              class="link"
              href={href}
              data-hire-event={event}
              data-hire-surface={surface}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu-footer">
      <div class="socials">
        {
          iconLinks.map(({ href, icon, label, event, surface }) => (
            <a href={href} class="social" data-hire-event={event} data-hire-surface={surface}>
              <span class="sr-only">{label}</span>
              <Icon icon={icon} />
            </a>
          ))
        }
      </div>

      <div class="theme-toggle">
        <ThemeToggle />
      </div>
    </div>
  </div>
</nav>
