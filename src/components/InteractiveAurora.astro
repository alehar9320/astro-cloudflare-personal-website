---
/**
 * InteractiveAurora.astro
 * Immersive "Northern Lights" background effect using HTML5 Canvas.
 * Optimized for performance and strictly following Alexander Härenstam's aesthetic.
 */
---

<div class="aurora-container" aria-hidden="true">
  <canvas id="aurora-canvas"></canvas>
</div>

<script>
  class AuroraEffect {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    width: number = 0;
    height: number = 0;
    animationFrameId: number = 0;
    mouse = { x: -1000, y: -1000 };
    lastMouse = { x: -1000, y: -1000 };
    resolutionScale = 0.5; // Draw at lower resolution for better performance

    // Aurora parameters
    bands: {
      yPercent: number;
      amplitude: number;
      frequency: number;
      offset: number;
      speed: number;
      color: string;
      thickness: number;
    }[] = [];
    numBands = 4;

    constructor(canvas: HTMLCanvasElement) {
      this.canvas = canvas;
      this.ctx = canvas.getContext('2d', { alpha: true })!;

      if (this.shouldSkip()) {
        this.canvas.style.display = 'none';
        return;
      }

      this.handleResize();
      this.createBands();
      this.draw();

      window.addEventListener('resize', this.handleResize);
      window.addEventListener('mousemove', this.handleMouseMove);

      document.addEventListener('astro:before-swap', () => this.cleanup(), { once: true });
    }

    shouldSkip() {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const isMobile = window.innerWidth < 800; // Principle: Scale down or disable on mobile
      return prefersReducedMotion || isMobile;
    }

    handleResize = () => {
      this.width = window.innerWidth;
      this.height = window.innerHeight;

      // Implement principle: Scaled resolution for performance
      this.canvas.width = this.width * this.resolutionScale;
      this.canvas.height = this.height * this.resolutionScale;

      if (this.bands.length === 0) {
        this.createBands();
      }
    };

    handleMouseMove = (e: MouseEvent) => {
      // Scale mouse coordinates to match canvas resolution
      this.mouse.x = e.clientX * this.resolutionScale;
      this.mouse.y = e.clientY * this.resolutionScale;
    };

    createBands() {
      this.bands = [];
      const colors = [
        'rgba(0, 210, 255, 0.25)',
        'rgba(0, 102, 204, 0.25)',
        'rgba(0, 255, 255, 0.15)',
      ];

      for (let i = 0; i < this.numBands; i++) {
        this.bands.push({
          yPercent: 0.2 + Math.random() * 0.6,
          amplitude: (50 + Math.random() * 100) * this.resolutionScale,
          frequency: 0.001 + Math.random() * 0.002,
          offset: Math.random() * 1000,
          speed: 0.005 + Math.random() * 0.01,
          color: colors[i % colors.length],
          thickness: (150 + Math.random() * 200) * this.resolutionScale,
        });
      }
    }

    draw() {
      const scaledWidth = this.width * this.resolutionScale;
      const scaledHeight = this.height * this.resolutionScale;

      this.ctx.clearRect(0, 0, scaledWidth, scaledHeight);

      // Smooth mouse movement for "refraction" feel
      this.lastMouse.x += (this.mouse.x - this.lastMouse.x) * 0.05;
      this.lastMouse.y += (this.mouse.y - this.lastMouse.y) * 0.05;

      this.bands.forEach((band) => {
        const baseY = scaledHeight * band.yPercent;

        this.ctx.beginPath();
        this.ctx.strokeStyle = band.color;
        this.ctx.lineWidth = band.thickness;
        this.ctx.lineCap = 'round';

        band.offset += band.speed;

        for (let x = 0; x <= scaledWidth; x += 10) {
          // Base sine wave movement
          const dx = x - this.lastMouse.x;
          const dy = baseY - this.lastMouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          // Distortion based on mouse proximity
          const distortion =
            Math.max(0, (150 * this.resolutionScale - dist) / (150 * this.resolutionScale)) *
            50 *
            this.resolutionScale;

          const y =
            baseY + Math.sin(x * band.frequency + band.offset) * band.amplitude + distortion;

          if (x === 0) {
            this.ctx.moveTo(x, y);
          } else {
            this.ctx.lineTo(x, y);
          }
        }
        this.ctx.stroke();
      });

      this.animationFrameId = requestAnimationFrame(() => this.draw());
    }

    cleanup() {
      cancelAnimationFrame(this.animationFrameId);
      window.removeEventListener('resize', this.handleResize);
      window.removeEventListener('mousemove', this.handleMouseMove);
    }
  }

  const canvas = document.getElementById('aurora-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    new AuroraEffect(canvas);
  }
</script>

<style>
  .aurora-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -2;
    pointer-events: none;
    overflow: hidden;
    background: transparent;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0.8;
    mix-blend-mode: screen;
    /* Principle: Offload heavy blurring to CSS/Hardware acceleration */
    filter: blur(80px);
  }

  @media (max-width: 50em) {
    /* Component is disabled in JS for these viewports,
       but we ensure the container is hidden visually too. */
    .aurora-container {
      display: none;
    }
  }
</style>
