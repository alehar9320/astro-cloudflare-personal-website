---
import { getEntry } from 'astro:content';

const flagsEntry = await getEntry('flags', 'config');
const isTactileEnabled = flagsEntry?.data.enable_pill_tactile_v1 ?? false;
---

<div class:list={['pill', { tactile: isTactileEnabled }]}><slot /></div>

<style>
  .pill {
    display: flex;
    padding: 0.5rem 1rem;
    gap: 0.5rem;
    color: var(--accent-text-over);
    border: 1px solid var(--accent-regular);
    background-color: var(--accent-regular);
    border-radius: 999rem;
    font-size: var(--text-md);
    line-height: 1.35;
    white-space: nowrap;

    /* Interactive state base styles */
    background-image: linear-gradient(
      110deg,
      var(--accent-regular) 0%,
      var(--gradient-stop-1) 50%,
      var(--gradient-stop-3) 100%
    );
    background-size: 250% 100%;
    background-position: 0% 50%;
    box-shadow: var(--shadow-sm);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pill.tactile {
      transition:
        transform 0.15s cubic-bezier(0.22, 1, 0.36, 1),
        box-shadow 0.15s ease;
    }

    .pill.tactile:hover,
    .pill.tactile:focus-visible {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .pill.tactile:active {
      transform: translateY(1px) scale(0.97);
      box-shadow: var(--shadow-sm);
    }
  }
</style>
