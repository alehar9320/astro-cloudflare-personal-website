---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
import { hire, hireMailto } from '../data/hire';
---

<aside>
  <h2>Ready to collaborate on high-impact initiatives?</h2>
  <div class="actions">
    <CallToAction href={hireMailto}>
      Email Alexander
      <Icon icon="paper-plane-tilt" size="1.2em" />
    </CallToAction>
    <a class="cv-link" href={hire.cvHref}>
      {hire.cvLabel}
      <Icon icon="download-simple" size="1.2em" />
    </a>
  </div>
</aside>

<style>
  aside {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    border-top: 1px solid hsla(var(--gray-999-basis), 0.2);
    border-bottom: 1px solid hsla(var(--gray-999-basis), 0.2);
    padding: 5rem 1.5rem;
    background: hsla(var(--gray-999-basis), 0.05);
    backdrop-filter: blur(32px) saturate(120%);
    -webkit-backdrop-filter: blur(32px) saturate(120%);
    box-shadow: var(--shadow-sm);
  }

  h2 {
    font-size: var(--text-xl);
    text-align: center;
    max-width: 15ch;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .cv-link {
    display: flex;
    place-content: center;
    align-items: center;
    text-align: center;
    padding: 0.5em 1.5em;
    gap: 0.6em;
    color: var(--gray-0);
    text-decoration: none;
    line-height: 1.1;
    border-radius: 999rem;
    border: 1px solid var(--accent-regular);
    background: hsla(var(--gray-999-basis), 0.5);
    white-space: nowrap;
    font-family: var(--font-brand);
    transition:
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease;
  }

  .cv-link:hover,
  .cv-link:focus-visible {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .cv-link:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 4px;
  }

  @media (min-width: 50em) {
    aside {
      padding: 7.5rem;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    h2 {
      font-size: var(--text-3xl);
      text-align: left;
    }

    .actions {
      align-items: flex-end;
    }
  }
</style>
