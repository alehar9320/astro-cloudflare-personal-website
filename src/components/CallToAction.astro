---
import { getEntry } from 'astro:content';

interface Props {
  href: string;
  target?: string;
  rel?: string;
  download?: boolean | string;
  'data-hire-event'?: string;
  'data-hire-surface'?: string;
}

const {
  href,
  target,
  rel,
  download,
  'data-hire-event': dataHireEvent,
  'data-hire-surface': dataHireSurface,
} = Astro.props;

const flagsEntry = await getEntry('flags', 'config');
const isTactileEnabled = flagsEntry?.data.enable_cta_tactile_v1 ?? false;
---

<a
  class:list={[{ tactile: isTactileEnabled }]}
  href={href}
  target={target}
  rel={rel}
  download={download}
  data-hire-event={dataHireEvent}
  data-hire-surface={dataHireSurface}
>
  <slot />
</a>

<style>
  a {
    position: relative;
    display: flex;
    place-content: center;
    text-align: center;
    padding: 0.56em 2em;
    gap: 0.8em;
    color: var(--accent-text-over);
    text-decoration: none;
    line-height: 1.1;
    border-radius: 999rem;
    overflow: hidden;
    background-color: var(--accent-regular);
    background-image: none;
    box-shadow: var(--shadow-sm);
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.15s ease;
  }

  @media (min-width: 20em) {
    a {
      font-size: var(--text-lg);
    }
  }

  a:hover,
  a:focus-visible {
    background-color: var(--accent-dark);
    box-shadow: var(--shadow-md);
  }

  a:focus-visible {
    outline: 2px solid var(--accent-regular);
    outline-offset: 4px;
  }

  a:active {
    background-color: var(--accent-dark);
    box-shadow: var(--shadow-sm);
  }

  a.tactile:active {
    transform: translateY(2px) scale(0.98);
  }

  /* Overlay for standard static hover effect no longer needed, using animated gradient */
  a::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: background-color var(--theme-transition);
    mix-blend-mode: overlay;
  }

  @media (min-width: 50em) {
    a {
      padding: 1.125rem 2.5rem;
      font-size: var(--text-xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }

    a:hover,
    a:focus-visible,
    a:active,
    a.tactile:active {
      transform: none;
    }
  }
</style>
