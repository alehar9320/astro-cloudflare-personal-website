---
import { getEntry } from 'astro:content';

interface Props {
  href: string;
  target?: string;
  rel?: string;
  download?: boolean | string;
  'data-hire-event'?: string;
  'data-hire-surface'?: string;
}

const {
  href,
  target,
  rel,
  download,
  'data-hire-event': dataHireEvent,
  'data-hire-surface': dataHireSurface,
} = Astro.props;

const flagsEntry = await getEntry('flags', 'config');
const isTactileEnabled = flagsEntry?.data.enable_cta_tactile_v1 ?? false;
---

<a
  class:list={[{ tactile: isTactileEnabled }]}
  href={href}
  target={target}
  rel={rel}
  download={download}
  data-hire-event={dataHireEvent}
  data-hire-surface={dataHireSurface}
>
  <slot />
</a>

<style>
  a {
    --cta-glow-color: hsla(210, 100%, 45%, 0.35);
    --cta-border-color: hsla(var(--gray-999-basis), 0.2);

    position: relative;
    display: flex;
    place-content: center;
    text-align: center;
    padding: 0.56em 2em;
    gap: 0.8em;
    color: var(--accent-text-over);
    text-decoration: none;
    line-height: 1.1;
    border-radius: 999rem;
    border: 1px solid var(--cta-border-color);
    overflow: hidden;
    background-color: var(--accent-regular);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    box-shadow: var(--shadow-sm);
    white-space: nowrap;
    transition:
      background-color 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease,
      transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (min-width: 20em) {
    a {
      font-size: var(--text-lg);
    }
  }

  a:hover {
    background-color: var(--accent-dark);
    border-color: hsla(var(--gray-999-basis), 0.4);
    box-shadow:
      0 10px 25px -4px var(--cta-glow-color),
      var(--shadow-md);
    transform: translateY(-2px);
  }

  a:focus-visible {
    background-color: var(--accent-dark);
    border-color: hsla(var(--gray-999-basis), 0.4);
    box-shadow:
      0 10px 25px -4px var(--cta-glow-color),
      var(--shadow-md);
    outline: 2px solid var(--accent-regular);
    outline-offset: 4px;
  }

  a:active {
    background-color: var(--accent-dark);
    box-shadow: var(--shadow-sm);
    transform: translateY(0);
  }

  a.tactile:active {
    transform: translateY(2px) scale(0.98);
  }

  /* Overlay for standard static hover effect no longer needed, using animated gradient */
  a::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: background-color var(--theme-transition);
    mix-blend-mode: overlay;
  }

  @media (min-width: 50em) {
    a {
      padding: 1.125rem 2.5rem;
      font-size: var(--text-xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }

    a:hover,
    a:focus-visible,
    a:active,
    a.tactile:active {
      transform: none;
    }
  }
</style>
